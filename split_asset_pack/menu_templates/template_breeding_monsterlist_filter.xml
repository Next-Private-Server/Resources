<template name="template_breeding_monsterlist_filter" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">
    
	<script src="scripts/BreedingV2/BreedingMonsterListFilter.lua"/>

    <element name="Items">
        <size dependentOnElement="PARENT" />
        <position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
        <orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />

        <ninesliceComponent name="BG">			
			<position relativeTo="element:name()" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="1" />
			<event name="onInit" params="component, element">
				<![CDATA[
					component("topHeight"):SetFloat(12.0)
					component("bottomHeight"):SetFloat(12.0)
					component("leftWidth"):SetFloat(12.0)
					component("rightWidth"):SetFloat(12.0)
					component("size"):SetFloat(1 * BreedingMenuScaleX())
					component("includeBorder"):SetInt(0)
					component("spriteName"):SetString("gfx/menu/soft_square_9s")
					component("layer"):SetString("MidPopUps")
                    -- fix up size	
                    component:setSize(lua_sys.Vector2(element:parent():absW() - 4 * BreedingMenuScaleX(), element:parent():absH()))				
				]]>
			</event>
		</ninesliceComponent>

    </element>

    <!-- if there are > 4 available genes, this opens the tray-->
    <template type="template_breeding_monsterlist_filter_item" name="ArrowButton">
        <position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="RIGHT" />
        <orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="0" yOffset="0" priorityOffset="-3" />

        <spriteSheetComponent name="Icon">
            <position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
            <orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />  
            <event name="onInit" params="component, element">
                component("spriteName"):SetString("icon_backing")
                component("sheetName"):SetString("xml_resources/breeding_menu.xml")
                component("size"):SetFloat(0.45 * BreedingMenuScaleX())
                component:setColor(0.5, 0.5, 0.5)
                component("layer"):SetString("MidPopUps")
            </event>
        </spriteSheetComponent>

    </template>

    <!-- a temp popup that allows filtering more than 4 genes and disappears when you click anywhere on the screen -  similar to activity center-->
    <element name="Tray">
        <size w="180*BreedingMenuScaleX()" h="200*BreedingMenuScaleY()" />
        <position relativeTo="PARENT" vAnchor="TOP" hAnchor="RIGHT" />
        <orientation vAnchor="TOP" hAnchor="LEFT" xOffset="24*BreedingMenuScaleX()" yOffset="-32*BreedingMenuScaleY()" priorityOffset="0" />
        <ninesliceComponent name="BG">
            <size dependentOnElement="element:name()" />
            <event name="onInit" params="component, element">
                component("topHeight"):SetFloat(16.0)
                component("bottomHeight"):SetFloat(16.0)
                component("leftWidth"):SetFloat(16.0)
                component("rightWidth"):SetFloat(16.0)
                component("size"):SetFloat(0.5*BreedingMenuScaleX())
                component("includeBorder"):SetInt(1)
                component("spriteName"):SetString("gfx/menu/menu_text_field")
                component("layer"):SetString("MidPopUps")
            </event>
        </ninesliceComponent> 
        
        <spriteSheetComponent name="Corner">
            <position relativeTo="element:name()" vAnchor="TOP" hAnchor="LEFT" />
            <orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="-5.5*BreedingMenuScaleX()" yOffset="48*BreedingMenuScaleY()" priorityOffset="0" />
            <event name="onInit" params="component, element">
                component("spriteName"):SetString("box_arrow")
                component("sheetName"):SetString("xml_resources/breeding_menu.xml")
                component("size"):SetFloat(0.5*BreedingMenuScaleX())
                component("layer"):SetString("MidPopUps")
            </event>
        </spriteSheetComponent>

        <element name="Grid"/>
    </element>

</template>