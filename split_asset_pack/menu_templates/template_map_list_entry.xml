<template name="template_map_list_entry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">
	<script src="scripts/MapIslandListEntry.lua"/>
		
	<defaultTemplateVar name="$layer" equals="PopUps" />

	<size w="420*game.mapScale()" h="102*game.mapScale()"/>

	<element name="BG">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite"/>
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
		<spriteSheetComponent name="Sprite">
			<event name="onInit" params="component, element">
				<![CDATA[ 
					-- bg is 562x144 (@2x)
					component("useOffsets"):SetInt(1) -- take the padding into account
					component("spriteName"):SetString("map_tag_island01")
					component("sheetName"):SetString("xml_resources/map_tags_sheet_01.xml")
					component("size"):SetFloat(1.5 * game.mapScale())
					component("layer"):SetString("$layer")
				]]>
			</event>
		</spriteSheetComponent>
	</element>

	<element name="Frame">
		<size dependentOnElement="BG" dependentOnComponent="Sprite"/>
		<position relativeTo="BG" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
		<ninesliceComponent name="Sprite">
			<size dependentOnElement="element:name()"/>
			<event name="onInit" params="component, element">
				<![CDATA[ 
					-- frame is 148x144 (@2x)
					component("topHeight"):SetFloat(144/2)
					component("bottomHeight"):SetFloat(144/2)
					component("leftWidth"):SetFloat(10)
					component("rightWidth"):SetFloat(134)
					component("includeBorder"):SetInt(1) -- include the border dimensions in the overall width/height
					component("size"):SetFloat(0.75*game.mapScale())
					component("spriteName"):SetString("gfx/menu/map/map_tag_frame")
					component("layer"):SetString("$layer")
				]]>
			</event>
		</ninesliceComponent>
	</element>

	<element name="ActiveIndicator">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="RIGHT" />
		<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="0" yOffset="0" priorityOffset="-1" />
		<spriteSheetComponent name="Sprite">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-10*game.mapScale()" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("map_tag_here_banner")
				component("sheetName"):SetString("xml_resources/map_icons_sheet.xml")
				component("size"):SetFloat(0.75*game.mapScale())
				component("layer"):SetString("$layer")
				component("visible"):SetInt(0)
			</event>
		</spriteSheetComponent>
	</element>

	<!--
	<element name="LabelDebug" debug="0,1,0">
		<size w="240*game.mapScale()"/>
		<position relativeTo="PARENT" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="81*game.mapScale()" yOffset="12*game.mapScale()" priorityOffset="-1" />
	</element>
	-->

	<element name="IslandName">
		<size dependentOnElement="element:name()" dependentOnComponent="Text"/>
		<position relativeTo="PARENT" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="81*game.mapScale()" yOffset="12*game.mapScale()" priorityOffset="-1" />
		<textComponent name="Text">
			<size w="240*game.mapScale()"/>
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("autoScale"):SetInt(1)
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTextFont())
				component("text"):SetString("Island Name")
				component("boundMode"):SetInt(lua_sys.MenuTextComponent_TEXT_BOUND_TIGHT)
				local scale = 0.525
				if game.currentLanguage() == "ja" then
					scale = 0.475
				end
				component("size"):SetFloat(scale*game.mapScale())
				component("layer"):SetString("$layer")
			</event>
		</textComponent>
	</element>

	<template type="template_spritesheetbutton" name="UpButton">
		<templateVar name="$upSpriteName" equals="button_map_sort_up" />
		<templateVar name="$sheetName" equals="'xml_resources/map_hud.xml'" />
		<templateVar name="$layer" equals="PopUps" />
		<templateVar name="$spriteScale" equals="0.75*game.mapScale()" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="50*game.mapScale()" yOffset="15*game.mapScale()" priorityOffset="-1" />
		
		<touchComponent name="Touch">
			<event name="onTouchDown" params="component, element">
				<![CDATA[
					onTouchDown(component, element)
					element["Text"]:setColor(0.5, 0.5, 0.5)
				]]>
			</event>
			<event name="onTouchUp" params="component, element">
				<![CDATA[
					onTouchUp(component, element)
					element["Text"]:setColor(1.0, 1.0, 1.0)
					element:onTouch()
				]]>
			</event>
			<event name="onTouchRelease" params="component, element">
				<![CDATA[
					onTouchRelease(component, element)
					element["Text"]:setColor(1.0, 1.0, 1.0)
				]]>
			</event>
		</touchComponent>

		<event name="onPostInit" params="element">
			element:setInvisible()
		</event>
	</template>

	<template type="template_spritesheetbutton" name="DownButton">
		<templateVar name="$upSpriteName" equals="button_map_sort_down" />
		<templateVar name="$sheetName" equals="'xml_resources/map_hud.xml'" />
		<templateVar name="$layer" equals="PopUps" />
		<templateVar name="$spriteScale" equals="0.75*game.mapScale()" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-10*game.mapScale()" yOffset="15*game.mapScale()" priorityOffset="-1" />
		
		<touchComponent name="Touch">
			<event name="onTouchDown" params="component, element">
				<![CDATA[
					onTouchDown(component, element)
					element["Text"]:setColor(0.5, 0.5, 0.5)
				]]>
			</event>
			<event name="onTouchUp" params="component, element">
				<![CDATA[
					onTouchUp(component, element)
					element["Text"]:setColor(1.0, 1.0, 1.0)
					element:onTouch()
				]]>
			</event>
			<event name="onTouchRelease" params="component, element">
				<![CDATA[
					onTouchRelease(component, element)
					element["Text"]:setColor(1.0, 1.0, 1.0)
				]]>
			</event>
		</touchComponent>

		<event name="onPostInit" params="element">
			element:setInvisible()
		</event>
	</template>

	<element name="Alert">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite"/>
		<position relativeTo="IslandName" vAnchor="VCENTER" hAnchor="RIGHT" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="12*game.hudScale()" yOffset="0" priorityOffset="-1" />
		<spriteSheetComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("goal_exclaim")
				component("sheetName"):SetString("xml_resources/hud01.xml")
				component("size"):SetFloat(0.6*game.hudScale())
				component("layer"):SetString("$layer")				
				component("visible"):SetInt(0)
			</event>
		</spriteSheetComponent>		

		<event name="onInit" params="element">
			element.transitionTime = 1.0
			element.transitionState = 1			
		</event>
		
		
		<event name="onTick" params="element, dt">
			<![CDATA[ 
			if element.transitionState ~= 0 and dt <= 0.5 then
				
				element["Sprite"]("size"):SetFloat(0.6*game.hudScale()*element.transitionTime)
				
				if element.transitionTime <= 1.0 then
					element.transitionState = 1
				elseif element.transitionTime >= 1.25 then
					element.transitionState = 2
				end	
	
				if element.transitionState == 1 then
					element.transitionTime = element.transitionTime + dt
				else
					element.transitionTime = element.transitionTime - dt
				end
			end
			]]>
		</event>

	</element>	
	
	<element name="MonstersCollected">
		<size dependentOnElement="element:name()" dependentOnComponent="Text"/>
		<position relativeTo="IslandName" vAnchor="BOTTOM" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="0" yOffset="0" priorityOffset="0" />
		<textComponent name="Text">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-12*game.mapScale()" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
				component("autoScale"):SetInt(0)
				component("font"):Set(game.getTextFont())
				component("text"):SetString("???/???")
				component("size"):SetFloat(0.35*game.mapScale())
				component("layer"):SetString("$layer")
				component("boundMode"):SetInt(lua_sys.MenuTextComponent_TEXT_BOUND_TIGHT)
			</event>
		</textComponent>
	</element>

	<element name="StatusStickers">
		<size w="288*game.mapScale()" h="33*game.mapScale()" />
		<position relativeTo="MonstersCollected" vAnchor="BOTTOM" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="0" yOffset="0" priorityOffset="0" />
	</element>

	<element name="Lock">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite"/>
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="RIGHT"/>
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-52*game.mapScale()" yOffset="-3*game.mapScale()" priorityOffset="-2" />
		<spriteSheetComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_lock")
				component("sheetName"):SetString("xml_resources/buttons01.xml")
				component("size"):SetFloat(0.525*game.mapScale())
				component("layer"):SetString("$layer")
			</event>
		</spriteSheetComponent>
	</element>

	<element name="SaleIcon">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite"/>
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="RIGHT"/>
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-52*game.mapScale()" yOffset="-3*game.mapScale()" priorityOffset="-2" />
		<spriteSheetComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("map_tag_sale")
				component("sheetName"):SetString("xml_resources/map_icons_sheet.xml")
				component("size"):SetFloat(0.8*game.mapScale())
				component("layer"):SetString("$layer")
			</event>
		</spriteSheetComponent>
	</element>

	<spriteSheetComponent name="TorchIndicator">
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="RIGHT" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-52*game.mapScale()" yOffset="-0*game.mapScale()" priorityOffset="-3" />
		<event name="onInit" params="component, element">
			component("spriteName"):SetString("button_light_torch")
			component("sheetName"):SetString("xml_resources/context_buttons.xml")
			component("size"):SetFloat(0.525*game.mapScale())
			component("layer"):SetString("$layer")
			component("visible"):SetInt(0)
		</event>
	</spriteSheetComponent>

	<spriteSheetComponent name="SeasonalIndicator">
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="RIGHT" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-10*game.mapScale()" yOffset="-6*game.mapScale()" priorityOffset="-3" />
		<event name="onInit" params="component, element">
			component("spriteName"):SetString("gene_halloween")
			component("sheetName"):SetString("xml_resources/hud02.xml")
			component("size"):SetFloat(0.5*game.hudScale())
			component("layer"):SetString("$layer")
			component("visible"):SetInt(0)
		</event>
	</spriteSheetComponent>

	
	<!-- Requirements -->
	<!-- text hcenter is wonky for some reason... -->
	<element name="Requirements">
		<size dependentOnElement="element:name()" dependentOnComponent="Text"/>
		<position relativeTo="MonstersCollected" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="0" yOffset="6*game.mapScale()" priorityOffset="-1" />
		<textComponent name="Text">
			<size w="240*game.mapScale()"/>
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(1)
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.375*game.mapScale())
				--component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED) 
				component("text"):SetString("Requires Level 10 and 1 Breeding Complete")
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				component("layer"):SetString("$layer")
			</event>
		</textComponent>
	</element>

	<!-- shows the cost-->
	<template type="template_map_info_item" name="Cost">
		<templateVar name="$spriteName" equals="game.StoreContext_SPRITE_COINS" />
		<templateVar name="$sheetName" equals="game.StoreContext_CURRENCY_SPRITESHEET" />
		<templateVar name="$spriteScale" equals="0.66" />
		<templateVar name="$toolTipEnabled" equals="0" />
		<position relativeTo="PARENT" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="90*game.mapScale()" yOffset="36*game.mapScale()" priorityOffset="-1" />					
	</template>

	<!-- sale cost-->
	<template type="template_map_info_item" name="SaleCost">
		<templateVar name="$spriteName" equals="game.StoreContext_SPRITE_COINS" />
		<templateVar name="$sheetName" equals="game.StoreContext_CURRENCY_SPRITESHEET" />
		<templateVar name="$spriteScale" equals="0.66" />
		<templateVar name="$toolTipEnabled" equals="0" />
		<position relativeTo="Cost" vAnchor="VCENTER" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="16*game.mapScale()" yOffset="0" priorityOffset="0" />		
		
		<!-- add a red stripe -->
		<ninesliceComponent name="RedStrip">
			<size w="4" h="4" />
			<position relativeTo="element:name()" component="Text" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("includeBorder"):SetInt(1)
				component("topHeight"):SetFloat(1.0)
				component("bottomHeight"):SetFloat(1.0)
				component("leftWidth"):SetFloat(1.0)
				component("rightWidth"):SetFloat(1.0)
				component("alpha"):SetFloat(0.6)
				component("spriteName"):SetString("gfx/menu/redstrip")
				component("layer"):SetString("$layer")
				component("visible"):SetInt(1)
			</event>

		</ninesliceComponent>

		<event name="Refresh" params="element">
			Refresh(element)
			element.RedStrip:setSize(Vector2(element.Text:absW(), element.RedStrip:absH()))
		</event>
	
		<event name="Show" params="element">
			Show(element)
			element.RedStrip:GetVar("visible"):SetInt(1)						
		</event>
	
		<event name="Hide" params="element">
			Hide(element)
			element.RedStrip:GetVar("visible"):SetInt(0)
		</event>

		<event name="updateComponents" params="element">
			updateComponents(element)
			element.RedStrip:GetVar("alpha"):SetFloat(element.alpha or 1)
		</event>

	</template>


	<touchComponent name="Touch" inline="true" handleMouseScrollEvents="1">
		<size dependentOnElement="PARENT"/>
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
	</touchComponent>

</template>