<template name="template_social_tab" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">

	<defaultTemplateVar name="$baseLayer" equals="MidPopUps" />
	<defaultTemplateVar name="$text" equals="" />
	<defaultTemplateVar name="$tabName" equals="" />
	
	<size dependentOnElement="element:name()" dependentOnComponent="bg" />
	
	<event name="selectTab" params="element">
		element:setOrientationPriority(-2)
		element:C("Label"):setColor(1, 1, 1)
	</event>
	
	<event name="deselectTab" params="element">
		element:setOrientationPriority(2)
		local palette = include("ColourPalette")
		element:C("Label"):setColor(palette:getRGBFloats(palette.TITLE_DARK_PURPLE))
	</event>

	<ninesliceComponent name="bg">
		<size w="110*game.windowScaleY()" h="30*game.windowScaleY()" />
		<event name="onInit" params="component, element">
			component("topHeight"):SetFloat(10.0)
			component("bottomHeight"):SetFloat(10.0)
			component("leftWidth"):SetFloat(77.0)
			component("rightWidth"):SetFloat(77.0)
			component("size"):SetFloat(0.3*game.windowScaleY())
			component("includeBorder"):SetInt(1)
			component("spriteName"):SetString("gfx/menu/tab02")
			component("layer"):SetString("$baseLayer")
		</event>
	</ninesliceComponent>

	<textComponent name="Label">
		<size w="60*game.windowScaleY()" />
		<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-3" />
		<event name="onInit" params="component, element">
			component("multiline"):SetInt(0)
			component("font"):Set(game.getTitleFont())
			component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
			component("size"):SetFloat(0.2*game.windowScaleY())
			component("autoScaleFactor"):SetFloat(0.01)
			component("autoScale"):SetInt(1)
			component("layer"):SetString("$baseLayer")
			component("text"):SetString("$text")
		</event>
	</textComponent>

	<element name="Alert">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-14*game.windowScaleY()" yOffset="4*game.windowScaleY()" priorityOffset="-1" />

		<spriteSheetComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("goal_exclaim")
				component("sheetName"):SetString("xml_resources/hud01.xml")
				component("size"):SetFloat(0.5*game.windowScaleY())
				component("layer"):SetString("$baseLayer")
			</event>			
		</spriteSheetComponent>

		<event name="onInit" params="element">
			element("transitionTime"):SetFloat(1.0)
			element("transitionState"):SetInt(1)
		</event>

		<event name="onTick" params="element, dt">
			<![CDATA[
				local transitionState = element("transitionState"):GetInt()

				if(transitionState ~= 0 and dt <= 0.5) then
					local transitionTime = element("transitionTime"):GetFloat()

					element:C("Sprite")("size"):SetFloat(0.5*game.windowScaleY()*transitionTime)

					if(transitionTime <= 1.0) then
						element("transitionState"):SetInt(1)
					elseif(transitionTime >= 1.25) then
						element("transitionState"):SetInt(2)
					end

					if(transitionState == 1) then
						element("transitionTime"):SetFloat(transitionTime + dt)
					else
						element("transitionTime"):SetFloat(transitionTime - dt)
					end
				end
			]]>
		</event>
		
		<event name="setVisible" params="element">
			element:C("Sprite")("visible"):SetInt(1)
			element("transitionState"):SetInt(1)
		</event>
		
		<event name="setInvisible" params="element">
			element:C("Sprite")("visible"):SetInt(0)
			element("transitionState"):SetInt(0)
		</event>
	</element>

	<touchComponent name="Touch">
		<size w="90*game.windowScaleY()" h="20*game.windowScaleY()" />
		<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
		<event name="onTouchUp" params="component, element">
			element:parent():parent():selectTab("$tabName")
		</event>
	</touchComponent>

</template>