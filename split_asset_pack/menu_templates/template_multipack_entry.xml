<template name="template_multipack_entry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">

	<script src="scripts/template_MultipackEntry.lua" />

	<defaultTemplateVar name="$frameHeight" equals="180*game.menuScaleY()" />
	<defaultTemplateVar name="$costumeId" equals="0" />
	<defaultTemplateVar name="$layer" equals="MidPopUps" />

	<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />

	<ninesliceComponent name="Sprite">
		<size w="150*game.menuScaleX()" h="element:templateVars().frameHeight" />
		<event name="onInit" params="component, element">
			component("topHeight"):SetFloat(160.0)
			component("bottomHeight"):SetFloat(64.0)
			component("leftWidth"):SetFloat(84.0)
			component("rightWidth"):SetFloat(72.0)
			component("size"):SetFloat(0.4*game.menuScaleX())
			component("includeBorder"):SetInt(1)
			component("spriteName"):SetString("gfx/menu/multichoice_box")
			component("layer"):SetString(element:templateVars().layer)
		</event>
	</ninesliceComponent>
	
	<element name="Animation">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="32 * game.menuScaleX()" priorityOffset="-2" />
	
		<spriteSheetComponent name="Spotlight">
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("popup_spotlight")
				component("sheetName"):SetString("xml_resources/multipack_sheet.xml")
				component("size"):SetFloat(0.4*game.menuScaleX())
				component("layer"):SetString(element:templateVars().layer)
			</event>
		</spriteSheetComponent>
	
		<aeComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("offsetCenter"):SetInt(1)
				component("layer"):SetString(element:parent():templateVars().layer)
			</event>
		</aeComponent>
	</element>
	
	<element name="ItemDesc">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="BuyButton" vAnchor="TOP" hAnchor="HCENTER" />
		<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="5*game.menuScaleX()" yOffset="0" priorityOffset="0" />
		<textComponent name="Text">
			<size w="115*game.menuScaleX()"/>
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTextFont())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString("JAMBOREE_MULTIPACK_BRONZE_DESC")
				component("size"):SetFloat(0.25*game.menuScaleX())
				component("layer"):SetString(element:templateVars().layer)
				component("autoScale"):SetInt(1)
				component("autoScaleFactor"):SetFloat(0.05)
			</event>
		</textComponent>
	</element>

	<spriteSheetComponent name="CostumeIcon">
		<position relativeTo="ItemDesc" vAnchor="VCENTER" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="0" yOffset="0" priorityOffset="0" />
		<event name="onInit" params="component, element">
			component("spriteName"):SetString("button_costume")
			component("sheetName"):SetString("xml_resources/buttons01.xml")
			component("size"):SetFloat(0.15*game.menuScaleX())
			component("layer"):SetString(element:templateVars().layer)
			component("visible"):SetInt(0)
		</event>
	</spriteSheetComponent>
	
	<template type="template_nineslicebutton" name="BuyButton">
		<templateVar name="$upSpriteName" equals="'gfx/menu/button_green_gem'" />
		<templateVar name="$spriteScale" equals="0.55*game.menuScaleX()" />
		<templateVar name="$text" equals="BUY_BUTTON" />
		<templateVar name="$font" equals="'game.getTitleFont()'" />
		<templateVar name="$textPadding" equals="0.55*game.hudScale() * 20" />
		<templateVar name="$textYOffset" equals="1" />
		
		<templateVar name="$topHeight" equals="20.0" />
		<templateVar name="$bottomHeight" equals="30.0" />
		<templateVar name="$leftWidth" equals="30.0" />
		<templateVar name="$rightWidth" equals="30.0" />
		
		<templateVar name="$width" equals="100*game.menuScaleX()" />
		<templateVar name="$height" equals="40*game.menuScaleX()" />

		<templateVar name="$includeBorder" equals="1" />
		
		<templateVar name="$layer" equals="element:templateVars().layer" />
		<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="-5*game.menuScaleX()" priorityOffset="-4" />

		<textComponent name="Text">
			<size w="80*game.menuScaleX()" h="5*game.menuScaleX()" />
			<event name="onInit" params="component, element">
				onInit(component, element)
				component("autoScale"):SetInt(0)
				component("size"):SetFloat(0.35*game.composerScale())
			</event>
		</textComponent>
		<!-- define this here so that it knows to use the overrides in template_MultipackEntry script -->
		<touchComponent name="Touch">
		</touchComponent>
	</template>
</template>
