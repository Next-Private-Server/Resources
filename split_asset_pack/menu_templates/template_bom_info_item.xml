<template name="template_bom_info_item" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">
	
	<defaultTemplateVar name="$layer" equals="'ContextBar'" />
	<defaultTemplateVar name="$sheetName" equals="'xml_resources/map_icons_sheet.xml'" />
	<defaultTemplateVar name="$spriteName" equals="'map_common_icon'" />
	<defaultTemplateVar name="$scale" equals="1" />
	<defaultTemplateVar name="$height" equals="60*game.menuScaleX()" />
	<defaultTemplateVar name="$spriteScale" equals="1" />
	<defaultTemplateVar name="$textR" equals="1" />
	<defaultTemplateVar name="$textG" equals="1" />
	<defaultTemplateVar name="$textB" equals="1" />
	
	<textComponent name="Text">
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="RIGHT" />
		<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="0" yOffset="0" priorityOffset="0" />
		<event name="onInit" params="component, element">
			component("multiline"):SetInt(0)
			component("font"):Set(game.getTextFont())
			component("size"):SetFloat(0.3 * $scale * game.menuScaleX())
			component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
			component("text"):SetString("28/18")
			component:setColor($textR, $textG, $textB)
			component("autoScaleFactor"):SetFloat(0.01)
			component("autoScale"):SetInt(1)
			component("layer"):SetString("$layer")
		</event>
	</textComponent>

	<spriteSheetComponent name="Sprite">
		<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
		<event name="onInit" params="component, element">		
			component("sheetName"):SetString("$sheetName")
			component("spriteName"):SetString("$spriteName")
			component("size"):SetFloat(0.5 * $scale * $spriteScale * game.menuScaleX())
			component("layer"):SetString("$layer")
		</event>
	</spriteSheetComponent>

	<event name="onPostInit" params="element">
		element.isVisible = true
		element:Refresh()
	</event>

	<event name="Refresh" params="element">
		local textWidth = element:GetComponent("Text"):absW()
		local totalWidth = textWidth + element:GetComponent("Sprite"):absW()
		element:setSize(lua_sys.Vector2(totalWidth, $height))
	</event>

	<event name="Show" params="element">
		element.isVisible = true
		element["Text"]("visible"):SetInt(1)
		element["Sprite"]("visible"):SetInt(1)
		element:Refresh()
	</event>

	<event name="Hide" params="element">
		element.isVisible = false
		element["Text"]("visible"):SetInt(0)
		element["Sprite"]("visible"):SetInt(0)
	</event>

	<event name="updateComponents" params="element">
		local alpha = element.alpha or 1.0
		element["Text"]("alpha"):SetFloat(alpha)
		element["Sprite"]("alpha"):SetFloat(alpha)
	</event>

	

</template>