<template name="template_breeding_monsterlist_feedoverlay" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">

    <!-- if the monster is too low level to breed, this element will appear over top the list element to prompt the user to feed the monster -->
		
    <ninesliceComponent name="Overlay">
        <size dependentOnElement="element:name()" />
        <event name="onInit" params="component, element">
            component("topHeight"):SetFloat(24.0)
            component("bottomHeight"):SetFloat(24.0)
            component("leftWidth"):SetFloat(24.0)
            component("rightWidth"):SetFloat(24.0)
            component("size"):SetFloat(0.5*BreedingMenuScaleX())
            component("includeBorder"):SetInt(1)
            component("spriteName"):SetString("gfx/menu/selectable_bar_grey_9s")
            component("alpha"):SetFloat(0.5)
            component("layer"):SetString("MidPopUps")
        </event>
    </ninesliceComponent>

    <touchComponent name="Touch">
        <size dependentOnElement="element:name()" />
        <position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
        <orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
        <event name="onTouchUp" params="component, element">				
            print("block touch")
        </event>
    </touchComponent>

    <textComponent name="Text">
        <position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
        <orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="8*BreedingMenuScaleY()" priorityOffset="-1" />
        <event name="onInit" params="component, element">
            component("font"):Set(game.getTextFont())
            component("size"):SetFloat(0.3*BreedingMenuScaleX())
            component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
            component("text"):SetString("BREEDING_FEED_DESC")
            component("layer"):SetString("MidPopUps")
        </event>
    </textComponent>
    
    
    <template type="template_nineslicebutton" name="FeedButton">
        <templateVar name="$upSpriteName" equals="'gfx/menu/button_vert_square01_green'" />
        <templateVar name="$spriteScale" equals="0.4*BreedingMenuScaleX()" />
        <templateVar name="$text" equals="BREEDING_FEED_CTA" />
        <templateVar name="$font" equals="'game.getTextFont()'" />
        <templateVar name="$textPadding" equals="6*BreedingMenuScaleX()" />
        <templateVar name="$textYOffset" equals="0" />
        <templateVar name="$layer" equals="'MidPopUps'" />
        <templateVar name="$topHeight" equals="17.0" />
        <templateVar name="$bottomHeight" equals="17.0" />
        <templateVar name="$leftWidth" equals="17.0" />
        <templateVar name="$rightWidth" equals="17.0" />

        <templateVar name="$width" equals="120*BreedingMenuScaleX()" />
        <templateVar name="$height" equals="36*BreedingMenuScaleX()" />
        
        <templateVar name="$includeBorder" equals="1" />
        
        <position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="HCENTER" />
        <orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="4*BreedingMenuScaleX()" priorityOffset="-2" />
        
        <touchComponent name="Touch">
            <event name="onTouchUp" params="component, element">
                onTouchUp(component, element)
                element:parent():handleTouchUp()
            </event>
        </touchComponent>

    </template>

    <event name="setClipping" params="element, x, y, w, h">
        <![CDATA[
            element.Overlay:setClipRect(x, y, w, h)
            element.Touch:setClipRect(x, y, w, h)
            element.Text:setClipRect(x, y, w, h)

            local feedButton = element.FeedButton
            feedButton.BoundsSprite:setClipRect(x, y, w, h)
            feedButton.UpSprite:setClipRect(x, y, w, h)
            feedButton.DownSprite:setClipRect(x, y, w, h)
            feedButton.Text:setClipRect(x, y, w, h)
            feedButton.Touch:setClipRect(x, y, w, h)
        ]]>
    </event>

    <event name="setVisible" params="element">
        <![CDATA[
            element.Overlay:GetVar("visible"):SetInt(1)
            element.Touch:GetVar("enabled"):SetInt(1)
            element.Text:GetVar("visible"):SetInt(1)

            local feedButton = element.FeedButton
            feedButton.BoundsSprite:GetVar("visible"):SetInt(1)
            feedButton.UpSprite:GetVar("visible"):SetInt(1)
            feedButton.DownSprite:GetVar("visible"):SetInt(1)
            feedButton.Text:GetVar("visible"):SetInt(1)
            feedButton.Touch:GetVar("enabled"):SetInt(1)
        ]]>
    </event>

    <event name="setInvisible" params="element">
        <![CDATA[
            element.Overlay:GetVar("visible"):SetInt(0)
            element.Touch:GetVar("enabled"):SetInt(0)
            element.Text:GetVar("visible"):SetInt(0)

            local feedButton = element.FeedButton
            feedButton.BoundsSprite:GetVar("visible"):SetInt(0)
            feedButton.UpSprite:GetVar("visible"):SetInt(0)
            feedButton.DownSprite:GetVar("visible"):SetInt(0)
            feedButton.Text:GetVar("visible"):SetInt(0)
            feedButton.Touch:GetVar("enabled"):SetInt(0)
        ]]>
    </event>

</template>