<template name="template_friends_indicator" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">
	
	<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
	
	<template type="template_indicator" name="Indicator">
	<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-22*game.hudScale()" yOffset="3*game.hudScale()" priorityOffset="-1" />
	</template>

	<event name="onInit" params="element">
		element:SetupGenericListener(game.engineReceiver(), "game::msg::MsgGameFriendsSynced", "refresh")
		element:SetupGenericListener(game.engineReceiver(), "game::msg::MsgFriendsUpdated", "refresh")
	
		element:DoStoredScript("refresh")
	</event>

	<event name="refresh" params="element">
		if game.hasIncomingFriendRequest() then
			element:E("Indicator"):Show()
		else
			element:E("Indicator"):Hide()
		end
	</event>

	<event name="SetVisible" params="element">
		element["Indicator"]:Show()
	</event>
	
	<event name="SetInvisible" params="element">
		element["Indicator"]:Hide()
	</event>
	
	<event name="SetEnabled" params="element">
		element["Indicator"]:SetEnabled()
	</event>
	
	<event name="SetDisabled" params="element">
		element["Indicator"]:SetDisabled()
	</event>
	
</template>