<template name="template_breeding_monsterlist_entry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">
	
	<script src="scripts/BreedingV2/BreedingMonsterListEntry.lua"/>
	
	<size dependentOnElement="Bg" dependentOnComponent="Sprite" />

	<element name="Bg">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
		
		<ninesliceComponent name="Sprite">
			<size w="164*BreedingMenuScaleX()" h="64*BreedingMenuScaleX()" />
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="RIGHT" />
			<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="0*BreedingMenuScaleX()" yOffset="0*BreedingMenuScaleX()" priorityOffset="0" />
			<event name="onInit" params="component, element">
				<![CDATA[
					component("topHeight"):SetFloat(24.0)
					component("bottomHeight"):SetFloat(24.0)
					component("leftWidth"):SetFloat(24.0)
					component("rightWidth"):SetFloat(24.0)
					component("size"):SetFloat(0.5*BreedingMenuScaleX())
					component("includeBorder"):SetInt(1)
					component("spriteName"):SetString("gfx/menu/selectable_bar_grey_9s")
					component("layer"):SetString("MidPopUps")
				]]>
			</event>
		</ninesliceComponent>
	</element>

	<element name="CharacterImage">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="2*BreedingMenuScaleX()" yOffset="2*BreedingMenuScaleY()" priorityOffset="-1" />
		<spriteComponent name="Sprite">
			<event name="onInit" params="component, element">
			<![CDATA[
				--component("spriteName"):SetString("gfx/breeding/"..game.getPortraitName(element:parent().MonsterID))
				component("size"):SetFloat(0.6*BreedingMenuScaleX())
				component("layer"):SetString("MidPopUps")
			]]>
			</event>
		</spriteComponent>
	</element>
	
	<element name="MonsterSpecies">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="CharacterImage" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0*BreedingMenuScaleX()" yOffset="6*BreedingMenuScaleY()" priorityOffset="-1" />
		<textComponent name="Text">
			<event name="onInit" params="component, element">
			<![CDATA[				
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.2*BreedingMenuScaleX())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
				--component("noTranslate"):SetInt(1)
				component("layer"):SetString("MidPopUps")
			]]>
			</event>
		</textComponent>
	</element>

	<element name="MonsterName">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="CharacterImage" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0*BreedingMenuScaleX()" yOffset="16*BreedingMenuScaleY()" priorityOffset="-1" />
		<textComponent name="Text">
			<event name="onInit" params="component, element">
			<![CDATA[				
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.2*BreedingMenuScaleX())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)				
				component("noTranslate"):SetInt(1)							
				component("layer"):SetString("MidPopUps")
				component:setColor(0.6, 0.6, 0.6)	
			]]>
			</event>
		</textComponent>
	</element>

	<element name="LevelSprite">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="CharacterImage" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="-1" />
		<spriteSheetComponent name="Sprite">
			<event name="onInit" params="component, element">
			<![CDATA[
				--local spriteString = "monster_level_numbers_"
				--local level = game.monsterLevel(element:parent().MonsterID)

				--if(level < 10) then
				--	spriteString = (spriteString.."0")
				--end
				
				--component("spriteName"):SetString(spriteString..level)
				component("sheetName"):SetString("xml_resources/level_numbers.xml")
				component("size"):SetFloat(0.5*BreedingMenuScaleX())
				component("layer"):SetString("MidPopUps")
			]]>
			</event>
		</spriteSheetComponent>
	</element>
	
	<touchComponent name="Touch">
		<size dependentOnElement="element:name()"/>
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
	</touchComponent>
	
	<template type="template_genes" name="Genes">
		<templateVar name="$Spacing" equals="-1*BreedingMenuScaleX()" />
		<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="RIGHT" />
		<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="6*BreedingMenuScaleX()" yOffset="8*BreedingMenuScaleX()" priorityOffset="-1" />
		<event name="onInit" params="element">
		<![CDATA[
			onInit(element)
			element("Layer"):SetString("MidPopUps")
			element("Size"):SetString(0.3*BreedingMenuScaleX())
		]]>
		</event>
	</template>

	<!-- only add as required
	<template type="template_breeding_monsterlist_feedoverlay" name="FeedOverlay">
		<size dependentOnElement="PARENT" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-3" />		
	</template>
	-->

</template>