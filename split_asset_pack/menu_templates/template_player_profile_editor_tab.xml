<template name="template_player_profile_editor_tab" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">

	<defaultTemplateVar name="$layer" equals="MidPopUps" />
	<defaultTemplateVar name="$tabName" equals="" />
	<defaultTemplateVar name="$sheetName" equals="'xml_resources/hud03.xml'" />
	<defaultTemplateVar name="$spriteName" equals="'profileeditor_avatar_icon'" />
	<defaultTemplateVar name="$spriteScale" equals="0.5*game.windowScaleY()" />
	
	<size dependentOnElement="element:name()" dependentOnComponent="bg" />
	
	<event name="selectTab" params="element">
		element:C("bg")("spriteName"):SetString("gfx/menu/selectable_bar_yellow_9s")
	</event>
	
	<event name="deselectTab" params="element">
		element:C("bg")("spriteName"):SetString("gfx/menu/selectable_bar_grey_9s")
	</event>

	<ninesliceComponent name="bg">
		<size w="32*game.windowScaleY()" h="26*game.windowScaleY()" />
		<event name="onInit" params="component, element">
			component("topHeight"):SetFloat(24.0)
			component("bottomHeight"):SetFloat(24.0)
			component("leftWidth"):SetFloat(24.0)
			component("rightWidth"):SetFloat(24.0)
			component("size"):SetFloat(0.25*game.windowScaleY())
			component("includeBorder"):SetInt(1)
			component("spriteName"):SetString("gfx/menu/selectable_bar_grey_9s")
			component("layer"):SetString("$layer")
		</event>
	</ninesliceComponent>

	<spriteSheetComponent name="Icon">
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-2*game.windowScaleY()" priorityOffset="-1" />
		<event name="onInit" params="component, element">
			component("size"):SetFloat($spriteScale)
			component("sheetName"):SetString("$sheetName")
			component("spriteName"):SetString("$spriteName")
			component("layer"):SetString("$layer")
		</event>
	</spriteSheetComponent>

	<touchComponent name="Touch">
		<size w="32*game.windowScaleY()" h="26*game.windowScaleY()" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
		<event name="onTouchUp" params="component, element">
			element:parent():parent():selectTab("$tabName")
		</event>
	</touchComponent>

</template>