<?xml version="1.0" encoding="utf-8"?>
<template name="template_reward_track_bar" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">
  	<script src="scripts/RewardTrackBar.lua" />

	<defaultTemplateVar name="$layer" equals="PopUps" />
	<defaultTemplateVar name="$scale" equals="game.hudScale()" />
	<defaultTemplateVar name="$backingSpriteName" equals="'stats_bar'" />
	<defaultTemplateVar name="$backingSheetName" equals="'xml_resources/hud01.xml'" />
	<defaultTemplateVar name="$barSpriteName" equals="'sticker_progress_bar'" />
	<defaultTemplateVar name="$barSheetName" equals="'xml_resources/hud01.xml'" />

	<size dependentOnElement="BarBackingSprite" />

    <touchComponent name="TouchBlocker">
        <size w="screenWidth()" h="screenHeight()" />
        <position relativeTo="SCREEN" hAnchor="HCENTER" vAnchor="VCENTER"/>
        <orientation priorityOffset="1" />
		<event name="onInit" params="component, element">
			component("enabled"):SetInt(0)
		</event>
    </touchComponent>

	<spriteSheetComponent name="BarBackingSprite">
		<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
		<event name="onInit" params="component, element">
			component("spriteName"):SetString("$backingSpriteName")
			component("sheetName"):SetString("$backingSheetName")
			component("layer"):SetString("$layer")
			component("size"):SetFloat(0.8*$scale)
			component:setPositionBroadcast(true)
		</event>
	</spriteSheetComponent>

	<spriteSheetComponent name="BarSprite">
		<position relativeTo="element:name()" component="BarBackingSprite" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
		<event name="onInit" params="component, element">
			component("spriteName"):SetString("$barSpriteName")
			component("sheetName"):SetString("$barSheetName")
			component("size"):SetFloat(0.8*$scale)
			component("layer"):SetString("$layer")
			component("FullMaskH"):SetInt(component("maskHeight"):GetInt())
			component("FullMaskW"):SetInt(component("maskWidth"):GetInt())
		</event>
	</spriteSheetComponent>

	<textComponent name="Text">
		<size dependentOnElement="element:name()" />
		<position relativeTo="element:name()" component="BarBackingSprite" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
		<event name="onInit" params="component, element">
			component("textPadding"):SetInt(8)
			component("multiline"):SetInt(0)
			component("font"):Set(game.getTextFont())
			component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
			component("size"):SetFloat(0.28*$scale)
			component("text"):SetString("0")
			component("autoScaleFactor"):SetFloat(0.01)
			component("autoScale"):SetInt(1)
			component("layer"):SetString("$layer")
		</event>
	</textComponent>

	<template type="template_dynamic_sprite" name="RewardSprite1">
		<templateVar name="$layer" equals="element:parent():templateVars().layer" />
		<templateVar name="$targetSize" equals="30*element:parent():templateVars().scale" />
		<templateVar name="$sizeMode" equals="height" />
		<position relativeTo="PARENT" component="BarBackingSprite" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="8*element:parent():templateVars().scale" yOffset="8*element:parent():templateVars().scale" priorityOffset="-2" />
	</template>

	<element name="RewardCollectAnim1">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="RewardSprite1" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
		<aeComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("offsetCenter"):SetInt(1)
				component("animationName"):SetString("xml_bin/collect_encore.bin")
				component("animation"):SetString("collect_encore")
				component("layer"):SetString("$layer")
				component("visible"):SetInt(0)
				local scale = 1.0 * $scale;
				component:setScale(Vector2(scale, scale))
			</event>
		</aeComponent>
	</element>

	<textComponent name="RewardText1">
		<size w="80*element:templateVars().scale" h="50*element:templateVars().scale" />
		<position relativeTo="RewardSprite1" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="2*element:templateVars().scale" priorityOffset="0" />
		<event name="onInit" params="component, element">
			component("multiline"):SetInt(0)
			component("font"):Set(game.getTextFont())
			component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
			component("size"):SetFloat(0.4*$scale)
			component("text"):SetString("")
			component("autoScaleFactor"):SetFloat(0.01)
			component("autoScale"):SetInt(1)
			component("layer"):SetString("$layer")
		</event>
	</textComponent>

	<template type="template_dynamic_sprite" name="RewardSprite2">
		<templateVar name="$layer" equals="element:parent():templateVars().layer" />
		<templateVar name="$targetSize" equals="24*element:parent():templateVars().scale" />
		<templateVar name="$sizeMode" equals="height" />
		<position relativeTo="PARENT" component="BarSprite" vAnchor="BOTTOM" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-12*element:parent():templateVars().scale" priorityOffset="-2" />
	</template>

	<element name="RewardCollectAnim2">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="RewardSprite2" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
		<aeComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("offsetCenter"):SetInt(1)
				component("animationName"):SetString("xml_bin/collect_encore.bin")
				component("animation"):SetString("collect_encore")
				component("layer"):SetString("$layer")
				component("visible"):SetInt(0)
				local scale = 0.5 * $scale;
				component:setScale(Vector2(scale, scale))
			</event>
		</aeComponent>
	</element>

	<template type="template_dynamic_sprite" name="RewardSprite3">
		<templateVar name="$layer" equals="element:parent():templateVars().layer" />
		<templateVar name="$targetSize" equals="24*element:parent():templateVars().scale" />
		<templateVar name="$sizeMode" equals="height" />
		<position relativeTo="PARENT" component="BarSprite" vAnchor="BOTTOM" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-12*element:parent():templateVars().scale" priorityOffset="-2" />
	</template>

	<element name="RewardCollectAnim3">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="RewardSprite3" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
		<aeComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("offsetCenter"):SetInt(1)
				component("animationName"):SetString("xml_bin/collect_encore.bin")
				component("animation"):SetString("collect_encore")
				component("layer"):SetString("$layer")
				component("visible"):SetInt(0)
				local scale = 0.5 * $scale;
				component:setScale(Vector2(scale, scale))
			</event>
		</aeComponent>
	</element>

	<event name="hide" params="element">
		element:C("BarBackingSprite")("visible"):SetInt(0)
		element:C("BarSprite")("visible"):SetInt(0)
		element:C("Text")("visible"):SetInt(0)
		element:C("RewardText1")("visible"):SetInt(0)
		element:E("RewardSprite1"):Hide()
		element:E("RewardSprite2"):Hide()
		element:E("RewardSprite3"):Hide()
		element.isVisible = 0
	</event>

	<event name="show" params="element">
		element:C("BarBackingSprite")("visible"):SetInt(1)
		element:C("BarSprite")("visible"):SetInt(1)
		element:C("RewardText1")("visible"):SetInt(1)
		element:C("Text")("visible"):SetInt(1)
		element.isVisible = 1
		element:RefreshCurrentRewardTrackData(element.targetTotalPoints)
	</event>
</template>