<template name="template_nucleus_set_progress_meter" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">
	<script src="scripts/NucleusSetProgressMeter.lua" />
	
	<defaultTemplateVar name="$layer" equals="'MidPopUps'" />
	<defaultTemplateVar name="$numGenes" equals="1" />
	<defaultTemplateVar name="$rarity" equals="'common'" />

	<size dependentOnElement="element:name()" dependentOnComponent="Bg" />

	<spriteSheetPickComponent name="Bg">
		<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
		<event name="onInit" params="component, element">
			<![CDATA[
				component("sheetName"):SetString("xml_resources/nexus_nucleus_HUD_sheet.xml")
				component("spriteName"):SetString("frame_0" .. "$numGenes")
				component("size"):SetFloat(0.40*game.menuScaleX())
				component("layer"):SetString("$layer")
			]]>
		</event>
		<event name="onPick" params="component, element">
			<![CDATA[
				if element.isDisabled == false then
					lua_sys.playSoundFx("audio/sfx/menu_click_small.wav")
					element:parent():parent():gotoBOM(element.rarity, element.numGenes)
				end
			]]>
		</event>
	</spriteSheetPickComponent>

	<spriteSheetPickComponent name="FillSprite">
		<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="8*game.menuScaleX()" priorityOffset="-2" />
		<event name="onInit" params="component, element">
			<![CDATA[
		
				element.rarity = "$rarity"
				element.numGenes = math.floor("$numGenes")

				component("spriteName"):SetString("diamondfill_" .. "$rarity" .. "_0" ..tostring(element.numGenes))
				component("sheetName"):SetString("xml_resources/nexus_nucleus_HUD_sheet.xml")

				component("size"):SetFloat(0.40*game.menuScaleX())
				component("layer"):SetString("$layer")

				component("FullMaskH"):SetInt(component("maskHeight"):GetInt())
				component("FullMaskY"):SetInt(component("maskY"):GetInt())

			]]>
		</event>
		<event name="onPick" params="component, element">
			<![CDATA[
				if element.isDisabled == false then
					lua_sys.playSoundFx("audio/sfx/menu_click_small.wav")
					element:parent():parent():gotoBOM(element.rarity, element.numGenes)
				end
			]]>
		</event>
	</spriteSheetPickComponent>

</template>