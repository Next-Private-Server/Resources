<template name="template_club_perf_editor" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">
	<script src="scripts/template_ClubboxPerfEditor.lua" />

	<size dependentOnElement="PerfEditorBg" dependentOnComponent="Sprite" />

	<element name="PerfEditorBg">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
		<ninesliceComponent name="Sprite">
			<size w="(lua_sys.screenHeight()*1.5)*0.5" h="lua_sys.screenHeight()*0.475" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("topHeight"):SetFloat(20.0)
				component("bottomHeight"):SetFloat(20.0)
				component("leftWidth"):SetFloat(20.0)
				component("rightWidth"):SetFloat(20.0)
				component("size"):SetFloat(0.5*game.windowScaleY())
				component("includeBorder"):SetInt(1)
				component("spriteName"):SetString("gfx/clubbox/clubbox_screen_9slice")
				component("layer"):SetString("MidPopUps")
			</event>
		</ninesliceComponent>
	</element>

	<element name="Scanlines">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-17" />
		<ninesliceComponent name="Sprite">
			<size w="(lua_sys.screenHeight()*1.5)*0.5-8*game.windowScaleY()" h="lua_sys.screenHeight()*0.475-10*game.windowScaleY()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("topHeight"):SetFloat(20.0)
				component("bottomHeight"):SetFloat(20.0)
				component("leftWidth"):SetFloat(20.0)
				component("rightWidth"):SetFloat(20.0)
				component("size"):SetFloat(0.25*game.windowScaleY())
				component("includeBorder"):SetInt(1)
				component("spriteName"):SetString("gfx/clubbox/clubbox_screen_scanlines_9slice")
				component("layer"):SetString("MidPopUps")
			</event>
		</ninesliceComponent>
	</element>
	
	<element name="PerformerListView">
		<size dependentOnElement="element:parent().PerfEditorBg" dependentOnComponent="Sprite" />
		<position relativeTo="element:parent().PerfEditorBg" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />

		<template type="template_club_perfSlider" name="Prop0">
			<position relativeTo="Prop1" vAnchor="VCENTER" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="8*game.windowScaleY()" yOffset="0" priorityOffset="0" />

			<element name="OptionsIcon">
				<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="RIGHT" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-2.5*(screenHeight()/320)" yOffset="-4*(screenHeight()/320)" priorityOffset="-1" />
				<spriteSheetComponent name="Sprite" >
					<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
					<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
					<event name="onInit" params="component, element">
					<![CDATA[
						component("spriteName"):SetString("costume_options_icon")
						component("sheetName"):SetString("xml_resources/clubbox_customization_menu.xml")
						component("size"):SetFloat(0.4*(screenHeight()/320))
						component("layer"):SetString("MidPopUps")
					]]>
					</event>
				</spriteSheetComponent>
				<event name="setVisible" params="element">
					element.Sprite("visible"):SetInt(1)
				</event>
				<event name="setInvisible" params="element">
					element.Sprite("visible"):SetInt(0)
				</event>
			</element>

		</template>

		<template type="template_club_perfSlider" name="Prop1">
			<position relativeTo="Prop2" vAnchor="VCENTER" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="8*game.windowScaleY()" yOffset="0" priorityOffset="0" />
		</template>

		<template type="template_club_perfSlider" name="Prop2">
			<position relativeTo="element:parent():parent().PerfEditorBg" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="4*game.windowScaleY()" yOffset="8*game.windowScaleY()" priorityOffset="-1" />
		</template>

		<template type="template_club_perfSlider" name="Prop3">
			<position relativeTo="element:parent():parent().PerfEditorBg" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="4*game.windowScaleY()" yOffset="8*game.windowScaleY()" priorityOffset="-1" />
		</template>

		<template type="template_club_perfSlider" name="Prop4">
			<position relativeTo="Prop3" vAnchor="VCENTER" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="8*game.windowScaleY()" yOffset="0" priorityOffset="0" />
		</template>

		<template type="template_club_perfSlider" name="Prop5">
			<position relativeTo="Prop4" vAnchor="VCENTER" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="8*game.windowScaleY()" yOffset="0" priorityOffset="0" />
		</template>
		
	</element>

	<element name="CostumeView">
		<size dependentOnElement="PerfEditorBg" dependentOnComponent="Sprite" />
		<position relativeTo="element:parent().PerfEditorBg" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="-1" />
	
		<element name="BackButton">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="element:parent():parent().PerfEditorBg" vAnchor="TOP" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="20*game.windowScaleY()" yOffset="20*game.windowScaleY()" priorityOffset="-1" />
			<spriteSheetComponent name="Sprite" >
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onInit" params="component, element">
				<![CDATA[
					component("spriteName"):SetString("button_arrow")
					component("sheetName"):SetString("xml_resources/clubbox_customization_volume.xml")
					component("originalSize"):SetFloat(0.35*game.windowScaleY())
					component("size"):SetFloat(component("originalSize"):GetFloat())
					component("layer"):SetString("MidPopUps")
				]]>
				</event>
			</spriteSheetComponent>
			<touchComponent name="Touch">
				<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
				<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onTouchUp" params="component, element">
					element:parent():parent():setPerformerView()
					element.Sprite("size"):SetFloat(element.Sprite("originalSize"):GetFloat())
				</event>
				<event name="onTouchDown" params="component, element, x, y">
					element.Sprite("size"):SetFloat(element.Sprite("originalSize"):GetFloat()*0.9)
				</event>
				<event name="onTouchRelease" params="component, element">
					element.Sprite("size"):SetFloat(element.Sprite("originalSize"):GetFloat())
				</event>
			</touchComponent>
			<event name="setVisible" params="element">
				element.Sprite("visible"):SetInt(1)
				element.Touch("enabled"):SetInt(1)
			</event>
			<event name="setInvisible" params="element">
				element.Sprite("visible"):SetInt(0)
				element.Touch("enabled"):SetInt(0)
			</event>

			<event name="enable" params="element">
				element.Sprite:setColor(1.0,1.0,1.0)
				element.Touch("enabled"):SetInt(1)
			</event>
			<event name="disable" params="element">
				element.Sprite:setColor(0.5,0.5,0.5)
				element.Touch("enabled"):SetInt(0)
			</event>

		</element>
		
		<element name="MonsterAvatar">
			<position relativeTo="CostumeView" vAnchor="VCENTER" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="-2" />
			<aeComponent name="Anim">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onInit" params="component, element">
				<![CDATA[
					component("offsetCenter"):SetInt(1)
					component("layer"):SetString("MidPopUps")
				]]>
				</event>
			</aeComponent>
		</element>

		<template type="template_club_costumeEntry" name="Variant0">
			<templateVar name="$layer" equals="MidPopUps" />
			<position relativeTo="element:parent():parent().PerfEditorBg" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="10*game.windowScaleY()" priorityOffset="-1" />
		</template>
		<template type="template_club_costumeEntry" name="Variant1">
			<templateVar name="$layer" equals="MidPopUps" />
			<position relativeTo="Variant0" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="5*game.windowScaleY()" priorityOffset="0" />
		</template>
		<template type="template_club_costumeEntry" name="Variant2">
			<templateVar name="$layer" equals="MidPopUps" />
			<position relativeTo="Variant1" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="5*game.windowScaleY()" priorityOffset="0" />
		</template>
		<template type="template_club_costumeEntry" name="Variant3">
			<templateVar name="$layer" equals="MidPopUps" />
			<position relativeTo="Variant2" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="5*game.windowScaleY()" priorityOffset="0" />
		</template>
	</element>

	<element name="OptionsView">
		<size dependentOnElement="PARENT"/>
		<position relativeTo="element:parent().PerfEditorBg" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="-1" />
	
		<element name="BackButton">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="element:parent():parent().PerfEditorBg" vAnchor="TOP" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="20*game.windowScaleY()" yOffset="20*game.windowScaleY()" priorityOffset="-1" />
			<spriteSheetComponent name="Sprite" >
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onInit" params="component, element">
				<![CDATA[
					component("spriteName"):SetString("button_arrow")
					component("sheetName"):SetString("xml_resources/clubbox_customization_volume.xml")
					component("originalSize"):SetFloat(0.35*game.windowScaleY())
					component("size"):SetFloat(component("originalSize"):GetFloat())
					component("layer"):SetString("MidPopUps")
				]]>
				</event>
			</spriteSheetComponent>
			<touchComponent name="Touch">
				<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
				<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onTouchUp" params="component, element">
					element:parent():parent():setPerformerView()
					element.Sprite("size"):SetFloat(element.Sprite("originalSize"):GetFloat())
				</event>
				<event name="onTouchDown" params="component, element, x, y">
					element.Sprite("size"):SetFloat(element.Sprite("originalSize"):GetFloat()*0.9)
				</event>
				<event name="onTouchRelease" params="component, element">
					element.Sprite("size"):SetFloat(element.Sprite("originalSize"):GetFloat())
				</event>
			</touchComponent>
			<event name="setVisible" params="element">
				element.Sprite("visible"):SetInt(1)
				element.Touch("enabled"):SetInt(1)
			</event>
			<event name="setInvisible" params="element">
				element.Sprite("visible"):SetInt(0)
				element.Touch("enabled"):SetInt(0)
			</event>

			<event name="enable" params="element">
				element.Sprite:setColor(1.0,1.0,1.0)
				element.Touch("enabled"):SetInt(1)
			</event>
			<event name="disable" params="element">
				element.Sprite:setColor(0.5,0.5,0.5)
				element.Touch("enabled"):SetInt(0)
			</event>

		</element>

		<template type="template_toggle" name="ToggleScreenFx">
			<templateVar name="$layer" equals="MidPopUps"/>
			<templateVar name="$label" equals="LOC('OPTION_ENABLE_SCREEN_FX')" />
			<templateVar name="$showBG" equals="false"/>
			<size w="180*game.menuScaleX()" h="36*game.menuScaleY()" />
			<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="16*game.menuScaleY()" priorityOffset="-1" />
		</template>

	</element>
</template>