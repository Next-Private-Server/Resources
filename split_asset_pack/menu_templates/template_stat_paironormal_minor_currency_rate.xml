<template name="template_stat_coinrate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">

	<size w="228*game.menuScaleX()" h="20*game.menuScaleX()" />
	
	<textComponent name="Stat">
		<size w="114*game.menuScaleX()" h="20*game.menuScaleX()" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
		<event name="onInit" params="component, element">
			component("font"):Set(game.getTextFont())
			component("size"):SetFloat(0.22*game.menuScaleX())
			component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
			component("text"):SetString(game.getLocalizedText("STATS_DAILY_CHANCE"))
			component("layer"):SetString(game.selectedMonster() and "PopUps" or "FrontPopUps")
			component("autoScaleFactor"):SetFloat(0.01)
			component("autoScale"):SetInt(1)
		</event>
	</textComponent>
		
	<element name="Value">
		<size w="114*game.menuScaleX()" h="20*game.menuScaleX()" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
		<spriteSheetComponent name="CoinSprite">
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				require("Currencies"):applySheetProps(component, game.CurrencyType_EggWildcards)
				component("size"):SetFloat(0.3*game.menuScaleX())
				component("layer"):SetString(game.selectedMonster() and "PopUps" or "FrontPopUps")
			</event>
		</spriteSheetComponent>

		<textComponent name="Text">
			<position relativeTo="PARENT" component="CoinSprite" vAnchor="VCENTER" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				<![CDATA[
					component("noTranslate"):SetInt(1)
					component("font"):Set(game.getTextFont())
					component("size"):SetFloat(0.22*game.menuScaleX())
					component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
					component("layer"):SetString(game.selectedMonster() and "PopUps" or "FrontPopUps")
					component("autoScaleFactor"):SetFloat(0.01)
					component("autoScale"):SetInt(1)
					
				]]>
			</event>
		</textComponent>
		
		<!-- SharedObjectInfo assumes there's a suffix-->
		<textComponent name="Suffix">
			<position relativeTo="PARENT" component="Text" vAnchor="VCENTER" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.22*game.menuScaleX())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
				component("layer"):SetString(game.selectedMonster() and "PopUps" or "FrontPopUps")
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
			</event>
		</textComponent>
	</element>
	
	<event name="onPostInit" params="element">
		element:repopulate()
	</event>

	<event name="repopulate" params="element">
		<![CDATA[	
			local monsterId = 0
			if game.selectedMonster() then
				monsterId = game.selectedMonsterTypeId()
			else
				if game.storeContext() then
					monsterId = store:ItemId()
				else --assume BoM context
					monsterId = element:parent():parent():parent()("selectedMonster"):GetInt()
				end
			end
			
			local rate = PrettyNumber(game.getPaironormalWildcardProductionRate(monsterId) + 0.001, 1)
			if game.getPaironormalWildcardProductionRate(monsterId) >= 0 then
				--if monster is happy make this green using tags
				if game.selectedMonster() and game.monsterHappiness(game.selectedMonsterId()) > 0 then
					rate = "<c=".. require("ColourPalette").MODIFIER_APPLIED_COLOUR .. ">" .. rate .. "</c>"
				end
					
				local text = game.getLocalizedText("WILDCARD_COLLECTION_RATE")
				text = text:gsub("%${VALUE}", rate)
				element["Value"]["Text"]("text"):SetString(text)
			else
				element["Value"]["Text"]("text"):SetString("???")			
			end
		]]>
	</event>


	<event name="setVisible" params="element">
		element["Stat"]("visible"):SetInt(1)
		element["Value"]["Text"]("visible"):SetInt(1)
		element["Value"]["CoinSprite"]("visible"):SetInt(1)
		element["Value"]["Suffix"]("visible"):SetInt(1)
	</event>
	
	<event name="setInvisible" params="element">
		element["Stat"]("visible"):SetInt(0)
		element["Value"]["Text"]("visible"):SetInt(0)
		element["Value"]["CoinSprite"]("visible"):SetInt(0)
		element["Value"]["Suffix"]("visible"):SetInt(0)
	</event>
	
	<event name="updateComponents" params="element">
		local alpha = element("alpha"):GetFloat()
		element["Stat"]("alpha"):SetFloat(alpha)
		element["Value"]["Text"]("alpha"):SetFloat(alpha)
		element["Value"]["CoinSprite"]("alpha"):SetFloat(alpha)
		element["Value"]["Suffix"]("alpha"):SetFloat(alpha)
	</event>

</template>