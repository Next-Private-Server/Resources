<template name="template_instanceaecomponent" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">
		
	<size dependentOnElement="element:name()" dependentOnComponent="Anim" />
	
	<aeComponent name="Anim">
		<event name="onInit" params="component, element">
			component("offsetCenter"):SetInt(1)
			component("layer"):SetString(element("Layer"):GetString())
		</event>
	</aeComponent>
	
</template>