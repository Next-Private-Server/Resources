
<template name="template_dialog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../menus/menu.xsd">
	<script src="scripts/Dialog.lua" />

	<defaultTemplateVar name="$layer" equals="FrontPopUps"></defaultTemplateVar>
	<defaultTemplateVar name="$avatarSprite" equals="'gfx/clubbox/T-Pain_Big_Welcome'"></defaultTemplateVar>
	<defaultTemplateVar name="$avatarName" equals="DJ_NAME_TAG"></defaultTemplateVar>

	<defaultTemplateVar name="$isClubbox" equals="1" />

	<size w="screenWidth()" h="screenHeight()"/>

	<element name="Dialog">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="-20*game.windowScaleY()" priorityOffset="0" />
		<ninesliceComponent name="Sprite">
			<size w="420*game.windowScaleY()" h="85*game.windowScaleY()" />
			<event name="onInit" params="component, element">
				component("size"):SetFloat(0.25*game.windowScaleY())
				if $isClubbox == 0 then
					component("topHeight"):SetFloat(40.0)
					component("bottomHeight"):SetFloat(40.0)
					component("leftWidth"):SetFloat(40.0)
					component("rightWidth"):SetFloat(40.0)
					component("spriteName"):SetString("gfx/menu/Black9SFrame50")
				else
					component("topHeight"):SetFloat(40.0)
					component("bottomHeight"):SetFloat(40.0)
					component("leftWidth"):SetFloat(40.0)
					component("rightWidth"):SetFloat(40.0)
					component("spriteName"):SetString("gfx/clubbox/clubbox_textbox_9S")
				end
				component("includeBorder"):SetInt(1)
				component("layer"):SetString("$layer")
			</event>
		</ninesliceComponent>
		<textComponent name="Text">
			<size w="(420-40)*game.windowScaleY()" h="(85-20)*game.windowScaleY()" />
			<position relativeTo="element:name()" vAnchor="TOP" hAnchor="LEFT" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="20*game.windowScaleY()" yOffset="18*game.windowScaleY()" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(1)
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.25*game.windowScaleY())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
				component("noTranslate"):SetInt(1)
				component("autoScale"):SetInt(1)
				component("text"):SetString("CLUBBOX_TUTORIAL_SELECT_ACT")
				component("layer"):SetString("$layer")
			</event>
		</textComponent>

		<touchComponent name="Touch">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onTouchUp" params="component, element">
				local dialog = element:parent()
				if not dialog:IsTextComplete() then
					dialog:CompleteText()
				end
			</event>
		</touchComponent>
	</element>

	<element name="Avatar">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="Dialog" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="BOTTOM" hAnchor="LEFT" xOffset="16*game.windowScaleY()" yOffset="-8*game.windowScaleY()" priorityOffset="1" />
		<spriteComponent name="Sprite">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("$avatarSprite")
				component("layer"):SetString("$layer")
				component("size"):SetFloat(0.4*game.windowScaleY())
			</event>
		</spriteComponent>
	</element>

	<element name="Name">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="Dialog" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="40*game.windowScaleY()" yOffset="3*game.windowScaleY()" priorityOffset="-1" />
		<ninesliceComponent name="Sprite">
			<size w="120*game.windowScaleY()" h="30*game.windowScaleY()" />
			<event name="onInit" params="component, element">
				if $isClubbox == 0 then
					component("size"):SetFloat(0.3*game.windowScaleY())
					component("topHeight"):SetFloat(49.0)
					component("bottomHeight"):SetFloat(49.0)
					component("leftWidth"):SetFloat(50.0)
					component("rightWidth"):SetFloat(50.0)
					component("spriteName"):SetString("gfx/menu/GreyTitleFrame")
				else
					component("size"):SetFloat(0.4*game.windowScaleY())
					component("topHeight"):SetFloat(35.0)
					component("bottomHeight"):SetFloat(35.0)
					component("leftWidth"):SetFloat(35.0)
					component("rightWidth"):SetFloat(35.0)
					component("spriteName"):SetString("gfx/clubbox/clubbox_name_frame_9S")
				end
				component("includeBorder"):SetInt(1)
				component("layer"):SetString("$layer")
			</event>
		</ninesliceComponent>
		<textComponent name="Text">
			<size w="100*game.windowScaleY()" h="1.0*game.windowScaleY()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				component("size"):SetFloat(0.25*game.windowScaleY())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString("$avatarName")
				component("autoScale"):SetInt(1)
				component("layer"):SetString("$layer")
			</event>
		</textComponent>
	</element>

	<template type="template_spritesheetbutton" name="PreviousButton">
		<templateVar name="$sheetName" equals="'xml_resources/buttons01.xml'" />
		<templateVar name="$upSpriteName" equals="'button_play'" />
		<templateVar name="$layer" equals="element:templateVars().layer" />
		<templateVar name="$spriteHFlip" equals="1" />
		<templateVar name="$spriteScale" equals="0.5*game.windowScaleY()" />
		<position relativeTo="Dialog" vAnchor="VCENTER" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
		<touchComponent name="Touch">
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element:parent():PreviousDialog()
			</event>
		</touchComponent>
	</template>

	<template type="template_spritesheetbutton" name="NextButton">
		<templateVar name="$sheetName" equals="'xml_resources/buttons01.xml'" />
		<templateVar name="$upSpriteName" equals="'button_play'" />
		<templateVar name="$layer" equals="element:templateVars().layer" />
		<templateVar name="$spriteScale" equals="0.5*game.windowScaleY()" />
		<position relativeTo="Dialog" vAnchor="VCENTER" hAnchor="RIGHT" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
		<touchComponent name="Touch">
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element:parent():NextDialog()
			</event>
		</touchComponent>
	</template>


</template>