	<template type="template_nineslicebutton" name="BindAccountButton">
		<templateVar name="$upSpriteName" equals="'gfx/menu/button_purple_gem'" />
		<templateVar name="$text" equals="OPTION_BIND_ACCOUNT" />
		<templateVar name="$font" equals="'game.getTitleFont()'" />
		<templateVar name="$spriteScale" equals="0.27*game.hudScale()" />
		<templateVar name="$layer" equals="MidPopUps" />
		<templateVar name="$topHeight" equals="16.0" />
		<templateVar name="$bottomHeight" equals="16.0" />
		<templateVar name="$leftWidth" equals="23.0" />
		<templateVar name="$rightWidth" equals="23.0" />
		<templateVar name="$width" equals="lua_sys.screenWidth() * 0.3" />
		<templateVar name="$height" equals="lua_sys.screenHeight() * 0.08" />
		<templateVar name="$includeBorder" equals="1" />
		<templateVar name="$alpha" equals="0.0" />

		<position relativeTo="TitleFrame" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="0.05 * lua_sys.screenWidth()" yOffset="58*game.menuScaleY()" priorityOffset="0" />
		<touchComponent name="Touch">
			<event name="onTouchUp" params="component, element">
			if(element.enabled) then
				onTouchUp(component, element)
				game.logEvent("options_menu", "action", "bind_account_button")
				game.popPopUp()
				manager:setContext("BIND_ACCOUNT")
			else
				game.displayNotification(game.cantBindReason())
			end
			</event>
			<event name="onTouchRelease" params="component, element">
				if (element.enabled) then
					onTouchRelease(component, element)
				end

				element("ButtonState"):SetInt(game.BUTTON_RELEASED)
				element("TickTimer"):SetFloat(0.0)
			</event>
		</touchComponent>

		<template type="template_indicator" name="Indicator">
			<position relativeTo="PARENT" vAnchor="TOP" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="5*game.hudScale()" yOffset="5*game.hudScale()" priorityOffset="-1" />
		</template>

		<event name="onInit" params="element">
			onInit(element)
			if(game.playerLevel() &lt; 4) then
				element:DoStoredScript("disable")
				element["Touch"]("enabled"):SetInt(1)
			end

			-- show after first bind nag prompt
			if(game.showBindIndicator()) then
				element:E("Indicator"):Show()
			else
				element:E("Indicator"):Hide()
			end
		</event>
		<event name="onPostInit" params="element">
			if(game.canBind() == false) then
				element["Text"]("text"):SetString("OPTION_BOUND_ACCOUNTS")
			end	
		</event>
		<function name="updateComponents" params="element">
			updateComponents(element)
			local alpha = element("alpha"):GetFloat()
			element:E("Indicator"):SetAlpha(alpha)
		</function>
	</template>

