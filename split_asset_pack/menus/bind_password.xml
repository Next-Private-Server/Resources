		<position relativeTo="PasswordInput" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="20.0*game.hudScale()" priorityOffset="0" />
		<spriteSheetComponent name="Sprite">
