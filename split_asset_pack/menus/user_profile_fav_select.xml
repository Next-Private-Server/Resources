<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">

	<script src="scripts/UserProfileFavSelector.lua" />

	<event name="onPostInit" params="element">
		element("transitionState"):SetInt(1)
		element("transitionTime"):SetFloat(0.0)
		lua_sys.playSoundFx("audio/sfx/menu_slide.wav")
		element:onPostInitLua()
	</event>

	<event name="onTick" params="element, dt">
		<![CDATA[
			local transitionState = element("transitionState"):GetInt()
			if(transitionState ~= 0) then
				local transitionTime = element("transitionTime"):GetFloat()

				if(transitionState == 1) then
					transitionTime = (transitionTime + dt*3)
				elseif(transitionState == 2) then
					transitionTime = (transitionTime - dt*3)
				end

				transitionTime = clamp(transitionTime, 0.0, 1.0)
				element("transitionTime"):SetFloat(transitionTime)

				element:E("Panel")("xOffset"):SetFloat((lua_sys.screenWidth() * (0.5)) + (((-0.5) * lua_sys.screenWidth()) * (1 / transitionTime)))
				element:E("FadedBG"):C("Sprite") ("alpha"):SetFloat(transitionTime * 0.5)

				if(transitionTime == 1.0) then
					element("transitionState"):SetInt(0)
				elseif(transitionTime == 0.0) then
					element:root():popPopUp()
				end
			end
		]]>
	</event>

	<event name="queuePop" params="element">
		element("transitionState"):SetInt(2)
	</event>

	<element name="FadedBG">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="10" />
		<spriteComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("__BUILTIN__WHITE_TEXTURE")
				component:setScale(Vector2(lua_sys.screenWidth()*0.25, lua_sys.screenHeight()*0.25))
				component:setColor(0.0, 0.0, 0.0)
				component("alpha"):SetFloat(0.0)
				component("layer"):SetString("FrontPopUps")
				component("visible"):SetInt(1)
			</event>
		</spriteComponent>

		<touchComponent name="Touch">
			<size dependentOnElement="element:name()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
		</touchComponent>
	</element>

	<element name="Panel">
		<size dependentOnElement="element:name()" dependentOnComponent="bg" />
		<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-2 * lua_sys.screenWidth()" yOffset="0" priorityOffset="9" />

		<ninesliceComponent name="bg">
			<size w="400*game.windowScaleY()" h="240*game.windowScaleY()" />
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="1" />
			<event name="onInit" params="component, element">
				component("includeBorder"):SetInt(1)
				component("topHeight"):SetFloat(50.0)
				component("bottomHeight"):SetFloat(50.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("size"):SetFloat(0.3*game.windowScaleY())
				component("spriteName"):SetString("gfx/menu/Black9SFrame50")
				component("layer"):SetString("FrontPopUps")
			</event>
		</ninesliceComponent>

		<element name="Title">
			<size dependentOnElement="element:name()" dependentOnComponent="BlackCover" />
			<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<ninesliceComponent name="BlackCover">
				<size w="160*game.windowScaleY()" h="30*game.windowScaleY()" />
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onInit" params="component, element">
					<![CDATA[
						component("topHeight"):SetFloat(45.0)
						component("bottomHeight"):SetFloat(45.0)
						component("leftWidth"):SetFloat(50.0)
						component("rightWidth"):SetFloat(50.0)
						component("size"):SetFloat(0.25*game.windowScaleY())
						component("includeBorder"):SetInt(1)
						component("spriteName"):SetString("gfx/menu/GreyTitleFrame")
						component("layer"):SetString("FrontPopUps")
					]]>
				</event>
			</ninesliceComponent>

			<textComponent name="Text">
				<size w="160*game.windowScaleY()" h="30*game.windowScaleY()" />
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("multiline"):SetInt(0)
					component("font"):Set(game.getTitleFont())
					component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
					component("text"):SetString("PROFILE_EDITOR_FAVORITES")
					component("size"):SetFloat(0.3*game.windowScaleY())
					component("autoScale"):SetInt(1)
					component("autoScaleFactor"):SetFloat(0.1)
					component("layer"):SetString("FrontPopUps")
				</event>
			</textComponent>
		</element>
		
		<template type="template_spritesheetbutton" name="PreviousButton">
			<templateVar name="$layer" equals="FrontPopUps" />
			<templateVar name="$spriteScale" equals="0.2*game.windowScaleY()" />
			<position relativeTo="NextButton" vAnchor="VCENTER" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="28*game.windowScaleY()" yOffset="0" priorityOffset="-1" />

			<spriteComponent name="Arrow">
				<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-2*game.windowScaleY()" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("spriteName"):SetString("gfx/menu/button_small_play")
					component("hFlip"):SetInt(1)
					component("layer"):SetString("FrontPopUps")
				</event>
				<event name="onTick" params="component, element, dt">
					component("size"):SetFloat(element:C("UpSprite")("size"):GetFloat() * 1.6)
				</event>
			</spriteComponent>

			<touchComponent name="Touch">
            	<size dependentOnElement="element:name()"/>
				<position relativeTo="PARENT"/>
				<orientation priorityOffset="-5" />
				<event name="onTouchDown" params="component, element">
					onTouchDown(component, element)
					element:C("Arrow"):setColor(0.5, 0.5, 0.5)
				</event>
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					element:C("Arrow"):setColor(1.0, 1.0, 1.0)
					element:parent():parent():previousPage()
				</event>
				<event name="onTouchRelease" params="component, element">
					onTouchRelease(component, element)
					element:C("Arrow"):setColor(1.0, 1.0, 1.0)
				</event>
			</touchComponent>

			<event name="hide" params="element">
				element:C("Arrow")("visible"):SetInt(0)
				element:DoStoredScript("setInvisible")
			</event>

			<event name="show" params="element">
				element:C("Arrow")("visible"):SetInt(1)
				element:DoStoredScript("setVisible")
			</event>

			<event name="disable" params="element">
				element:C("Arrow"):setColor(0.5, 0.5, 0.5)
				disable(element)
			</event>

			<event name="enable" params="element">
				element:C("Arrow"):setColor(1.0, 1.0, 1.0)
				enable(element)
			</event>
		</template>

		<textComponent name="PageLabel">
			<size w="16*game.windowScaleY()" />
			<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="RIGHT" />
			<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="-52*game.windowScaleY()" yOffset="16*game.windowScaleY()" priorityOffset="-1" />

			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("size"):SetFloat(0.25*game.windowScaleY())
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				component("layer"):SetString("FrontPopUps")
				component("text"):SetString("0/0")
			</event>
			<event name="hide" params="element">
				element("visible"):SetInt(0)
			</event>

			<event name="show" params="element">
				element("visible"):SetInt(1)
			</event>
		</textComponent>

		<template type="template_spritesheetbutton" name="NextButton">
			<templateVar name="$layer" equals="FrontPopUps" />
			<templateVar name="$spriteScale" equals="0.2*game.windowScaleY()" />
			<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="RIGHT" />
			<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="14*game.windowScaleY()" yOffset="8*game.windowScaleY()" priorityOffset="-1" />

			<spriteComponent name="Arrow">
				<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-2*game.windowScaleY()" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("spriteName"):SetString("gfx/menu/button_small_play")
					component("layer"):SetString("FrontPopUps")
				</event>
				<event name="onTick" params="component, element, dt">
					component("size"):SetFloat(element:C("UpSprite")("size"):GetFloat() * 1.6)
				</event>
			</spriteComponent>

			<touchComponent name="Touch">
            	<size dependentOnElement="element:name()"/>
				<position relativeTo="PARENT"/>
				<orientation priorityOffset="-5" />
				<event name="onTouchDown" params="component, element">
					onTouchDown(component, element)
					element:C("Arrow"):setColor(0.5, 0.5, 0.5)
				</event>
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					element:C("Arrow"):setColor(1.0, 1.0, 1.0)
					element:parent():parent():nextPage()
				</event>
				<event name="onTouchRelease" params="component, element">
					onTouchRelease(component, element)
					element:C("Arrow"):setColor(1.0, 1.0, 1.0)
				</event>
			</touchComponent>

			<event name="hide" params="element">
				element:C("Arrow")("visible"):SetInt(0)
				element:DoStoredScript("setInvisible")
			</event>

			<event name="show" params="element">
				element:C("Arrow")("visible"):SetInt(1)
				element:DoStoredScript("setVisible")
			</event>

			<event name="disable" params="element">
				element:C("Arrow"):setColor(0.5, 0.5, 0.5)
				disable(element)
			</event>

			<event name="enable" params="element">
				element:C("Arrow"):setColor(1.0, 1.0, 1.0)
				enable(element)
			</event>
		</template>		
    </element>

	<template type="template_spritesheetbutton" name="BackButton">
		<templateVar name="$layer" equals="FrontPopUps" />
		<templateVar name="$spriteScale" equals="0.5*game.hudScale()" />
		<templateVar name="$buttonMapping" equals="game.confirmButton()" />
		<templateVar name="$buttonMappingAlt" equals="game.cancelButton()" />

		<position relativeTo="SAFE_AREA" vAnchor="BOTTOM" hAnchor="RIGHT" />
		<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="3*game.hudScale()" yOffset="12*game.hudScale()" priorityOffset="4" />

		<touchComponent name="Touch">
			<event name="onTouchDown" params="component, element">
				onTouchDown(component, element)
				element["Text"]:setColor(1.0, 1.0, 1.0)
				element["Overlay"]:setColor(0.5, 0.5, 0.5)
			</event>
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
				element:parent():closePopup()
			</event>
			<event name="onTouchRelease" params="component, element">
				onTouchRelease(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
			</event>
		</touchComponent>

		<spriteSheetComponent name="Overlay">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_back")
				component("sheetName"):SetString("xml_resources/context_buttons.xml")
				component("size"):SetFloat(0.5*game.hudScale())
				component("layer"):SetString("FrontPopUps")
			</event>
		</spriteSheetComponent>

		<textComponent name="Text">
			<size w="60*game.contextBarScale()" />
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
			<event name="onInit" params="component, element">
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				component("size"):SetFloat(0.25*game.hudScale())
				component:GetVar("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString("BACK")
				component("layer"):SetString("FrontPopUps")
			</event>
		</textComponent>

		<event name="onTick" params="element, dt">
			onTick(element, dt)
			if(element["UpSprite"]("size"):GetFloat() ~= element["Overlay"]("size"):GetFloat()) then
				element["Overlay"]("size"):SetFloat(element["UpSprite"]("size"):GetFloat())
			end
		</event>
	</template>

</menu>