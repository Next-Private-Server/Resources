<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">

	<template type="template_event_screen" name="EventScreen">
		<templateVar name="$layer" equals="FrontPopUps" />

		<templateVar name="$titleSprite" equals="'gfx/menu/event_screen/minigame_dipster_digs/seasonal_text_dipster_digs'"/>
		<templateVar name="$stickerSpriteSheet" equals="'xml_resources/multipack_dipster_dig_sheet.xml'"/>
		<templateVar name="$monsterSprite" equals="'gfx/menu/event_screen/minigame_dipster_digs/event_screen_monster'"/>
		<templateVar name="$mainSprite" equals="'gfx/menu/event_screen/minigame_dipster_digs/dipster_digs_event_image_02'"/>
		<templateVar name="$glowSprite" equals="'gfx/menu/event_screen/minigame_dipster_digs/event_screen_glow'"/>

		<templateVar name="$subtitle_refid" equals="DIPSTER_DIG_TITLE"/>

		<templateVar name="$text1_color" equals="'#b573f0'"/>
		<templateVar name="$text1_refid" equals="EVENT_OVER_SCREEN_DIPSTER_TOP"/>
		<templateVar name="$text2_refid" equals="EVENT_OVER_SCREEN_DIPSTER_BOTTOM"/>

		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
	</template>

	<template type="template_spritesheetbutton" name="CloseButton">
		<templateVar name="$layer" equals="FrontPopUps" />
		<templateVar name="$spriteScale" equals="0.5*game.hudScale()" />
		<templateVar name="$buttonMapping" equals="game.confirmButton()" />
		<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="8*game.hudScale()" priorityOffset="-1" />
		<touchComponent name="Touch">
			<event name="onTouchDown" params="component, element">
				onTouchDown(component, element)
				element["Overlay"]:setColor(0.5, 0.5, 0.5)
			</event>
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
				element:root():popPopUp()
			</event>
			<event name="onTouchRelease" params="component, element">
				onTouchRelease(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
			</event>
		</touchComponent>
		<spriteSheetComponent name="Overlay">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_yes")
				component("sheetName"):SetString("xml_resources/context_buttons.xml")
				component("layer"):SetString("FrontPopUps")
				component("size"):SetFloat(0.5*game.hudScale())
			</event>
		</spriteSheetComponent>
		<event name="onTick" params="element, dt">
			onTick(element, dt)
			if(element["UpSprite"]("size"):GetFloat() ~= element["Overlay"]("size"):GetFloat()) then
				element["Overlay"]("size"):SetFloat(element["UpSprite"]("size"):GetFloat())
			end
		</event>
	</template>

	<event name="onPostInit" params="component, element">
		<![CDATA[
			local eventScreen = component:E("EventScreen")
			eventScreen:E("CloseButton"):DoStoredScript("setInvisible")
			eventScreen:E("GoButton"):DoStoredScript("setInvisible")

			local closeButton = component:E("CloseButton")
			closeButton:relativeTo(eventScreen:E("bg"))
		]]>
	</event>
</menu>