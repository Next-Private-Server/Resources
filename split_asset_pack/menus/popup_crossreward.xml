<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">
	<script src="scripts/PopupCrossReward.lua"/>

	<template type="template_fade" name="FadedBG">
		<templateVar name="$layer" equals="MidPopUps" />
		<templateVar name="$priority" equals="11" />
		<templateVar name="$touchPriority" equals="-1" /> <!-- relative to priority -->		
		<templateVar name="$maxAlpha" equals="0.75" />
	</template>

	<template type="template_panel_basic" name="Panel">
		<templateVar name="$layer" equals="MidPopUps" />
        <templateVar name="$frame" equals="'gfx/menu/Black9SFrame50'" />
		<templateVar name="$endY" equals="-4*game.windowScaleY()" />
		<size w="320*game.windowScaleY()" h="200*game.windowScaleY()" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="screenHeight() * 2.0" priorityOffset="10" />
	
		<!-- middle -->
		<spriteSheetComponent name="Deco1">
			<position relativeTo="element:name()" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="-14*game.windowScaleY()" priorityOffset="1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("middle")
				component("sheetName"):SetString("xml_resources/multipack_encapsulator_sheet.xml")
				component("size"):SetFloat(0.5*game.windowScaleY())
				component("layer"):SetString("MidPopUps")
			</event>
		</spriteSheetComponent>

		<!-- bottom right -->
		<spriteSheetComponent name="Deco2">
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="RIGHT" />
			<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="-30*game.windowScaleY()" yOffset="8*game.windowScaleY()" priorityOffset="1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("lower_right_corner")
				component("sheetName"):SetString("xml_resources/multipack_encapsulator_sheet.xml")
				component("size"):SetFloat(0.5*game.windowScaleY())
				component("layer"):SetString("MidPopUps")
			</event>
		</spriteSheetComponent>

		<!-- top left -->
		<spriteSheetComponent name="Deco3">
			<position relativeTo="element:name()" vAnchor="TOP" hAnchor="LEFT" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="-18*game.windowScaleY()" yOffset="-52*game.windowScaleY()" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("left_corner")
				component("sheetName"):SetString("xml_resources/multipack_encapsulator_sheet.xml")
				component("size"):SetFloat(0.5*game.windowScaleY())
				component("layer"):SetString("MidPopUps")
			</event>
		</spriteSheetComponent>


		<element name="Header">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
			<ninesliceComponent name="Sprite">
				<size w="140*game.windowScaleY()" h="30*game.windowScaleY()" />
				<event name="onInit" params="component, element">
					component("topHeight"):SetFloat(40.0)
					component("bottomHeight"):SetFloat(40.0)
					component("leftWidth"):SetFloat(50.0)
					component("rightWidth"):SetFloat(50.0)
					component("size"):SetFloat(0.25*game.windowScaleY())
					component("includeBorder"):SetInt(1)
					component("spriteName"):SetString("gfx/menu/GreyTitleFrame")
					component("layer"):SetString("MidPopUps")
				</event>
			</ninesliceComponent>

			<element name="HeaderText">
				<size dependentOnElement="PARENT"/>
				<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<textComponent name="Text">
					<size w="130*game.windowScaleY()" h="18*game.windowScaleY()" />
					<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
					<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
					<event name="onInit" params="component, element">
						<![CDATA[
							component("multiline"):SetInt(0)
							component("font"):Set(game.getTitleFont())
							local palette = include("ColourPalette")
							component:setColor(palette:getRGBFloats(palette.TITLE_PROMO_TEAL))
							component("size"):SetFloat(0.35*game.windowScaleY())
							component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
							component("autoScale"):SetInt(1)
							component("layer"):SetString("MidPopUps")
							component("text"):SetString("CROSSREWARD_POPUP_TITLE")
						]]>
					</event>
				</textComponent>
			</element>

		</element>

		<element name="Description">
			<size dependentOnElement="element:name()" dependentOnComponent="Text"/>
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<textComponent name="Text">
				<size w="240*game.windowScaleY()" h="200*game.windowScaleY()" />
				<event name="onInit" params="component, element">
					component("font"):Set(game.getTextFont())
					component("multiline"):SetInt(1)
					component("size"):SetFloat(0.35*game.windowScaleY())					
					component("text"):SetString("CROSSREWARD_POPUP_DESC")
					component("autoScale"):SetInt(1)
					component("layer"):SetString("MidPopUps")
				</event>
			</textComponent>
		</element>
	
	</template>
	<template type="template_spritesheetbutton" name="ClaimButton">
		<templateVar name="$upSpriteName" equals="'button_continue_green'" />
		<templateVar name="$sheetName" equals="'xml_resources/buttons01.xml'" />
		<templateVar name="$spriteScale" equals="0.45*game.windowScaleY()" />
		<templateVar name="$layer" equals="FrontPopUps" />
		<position relativeTo="Panel" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-2*game.windowScaleY()" priorityOffset="-1" />
		<textComponent name="Label">
			<size w="90*game.windowScaleY()" h="22*game.windowScaleY()"/>
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				component("size"):SetFloat(0.22*game.windowScaleY())
				component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString("CLAIM_REWARDS")
				component("autoScale"):SetInt(1)
				component("layer"):SetString("FrontPopUps")
			</event>
		</textComponent>
		<touchComponent name="Touch">
			<event name="onTouchDown" params="component, element">
				<![CDATA[
					onTouchDown(component, element)
					element["Label"]:setColor(0.5, 0.5, 0.5)
				]]>
			</event>
			<event name="onTouchUp" params="component, element">
				<![CDATA[
					onTouchUp(component, element)
					element["Label"]:setColor(1.0, 1.0, 1.0)
					if element.Action then
						element:Action()
					end
				]]>
			</event>
			<event name="onTouchRelease" params="component, element">
				<![CDATA[
					onTouchRelease(component, element)
					element["Label"]:setColor(1.0, 1.0, 1.0)
				]]>
			</event>
		</touchComponent>
	</template>


</menu>