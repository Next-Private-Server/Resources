<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">

	<element name="BgElement">
		<hudScale scale="game.menuScaleX()" />
		<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
		<spriteComponent name="Sprite">
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="10" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("gfx/menu/logging_in")
				component:setScale(Vector2(lua_sys.screenHeight() / 768, lua_sys.screenHeight() / 768))
			</event>
		</spriteComponent>
	</element>

	<template type="template_fade" name="Fade">
		<templateVar name="$layer" equals="MidPopUps" />
		<templateVar name="$priority" equals="9" />
		<templateVar name="$r" equals="0.03" />
		<templateVar name="$g" equals="0.11" />
		<templateVar name="$b" equals="0.10" />
	</template>

	<element name="Frame">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="8" />
		<ninesliceComponent name="Sprite">
			<size w="340*game.hudScale()" h="275*game.hudScale()" />
			<event name="onInit" params="component, element">
				component("topHeight"):SetFloat(50.0)
				component("bottomHeight"):SetFloat(50.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("includeBorder"):SetInt(1)
				component("size"):SetFloat(0.5)
				component("spriteName"):SetString("gfx/menu/Black9SFrame50")
				component("layer"):SetString("MidPopUps")
			</event>
		</ninesliceComponent>
		<spriteSheetComponent name="Flourish1">
			<position relativeTo="element:name()" vAnchor="TOP" hAnchor="LEFT" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="7" yOffset="7" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("menu_swirl_01")
				component("sheetName"):SetString("xml_resources/hud01.xml")
				component("size"):SetFloat(0.5*game.hudScale())
				component("layer"):SetString("MidPopUps")
			</event>
		</spriteSheetComponent>
		<spriteSheetComponent name="Flourish2">
			<position relativeTo="element:name()" vAnchor="TOP" hAnchor="RIGHT" />
			<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="7" yOffset="10" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("menu_swirl_02")
				component("sheetName"):SetString("xml_resources/hud01.xml")
				component("size"):SetFloat(0.5*game.hudScale())
				component("rotation"):SetFloat(-0.5*math.pi)
				component("layer"):SetString("MidPopUps")
			</event>
		</spriteSheetComponent>
	</element>

	<element name="Logo">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="Frame" vAnchor="TOP" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-25*game.hudScale()" priorityOffset="-1" />
		<spriteComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("gfx/menu/msm_logo")
				component("size"):SetFloat(0.3*game.hudScale())
				component("layer"):SetString("MidPopUps")
			</event>
		</spriteComponent>
	</element>

	<element name="Subtitle">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="Logo" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-2*game.hudScale()" priorityOffset="0" />
		<textComponent name="Text">
			<size w="350*game.hudScale()" h="35*game.hudScale()" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.3*game.hudScale())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
				component("text"):SetString("LOGIN_CHOOSE_METHOD")
				component("autoScale"):SetInt(1)
				component("layer"):SetString("MidPopUps")
			</event>
		</textComponent>
	</element>

	<element name="Buttons">
		<position relativeTo="Frame" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="15*game.hudScale()" priorityOffset="-1" />

		<template type="template_login_button" name="AppleButton">
			<templateVar name="$spritePath" equals="'apple/appleid_button_'" />
			<position relativeTo="element:parent()" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<touchComponent name="Touch">
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					menu:popPopUp()
					game.logEvent("login_type_select", "login_method", game.getLoginMethodName(game.UserData_TYPE_APPLE), "last_login_method", game.lastLoginMethodName())
					game.authAccountIfExists(game.UserData_TYPE_APPLE)
				</event>
			</touchComponent>
			<event name="onPostInit" params="element">
				if ( game.canLoginToLoginType(game.UserData_TYPE_APPLE) == false or not game.appleIdAvailable() ) then
					element:DoStoredScript("setInvisible")
				elseif game.lastLoginMethodType() == game.UserData_TYPE_APPLE then
					element:DoStoredScript("showHighlight")
				end
			</event>
		</template>

		<template type="template_login_button" name="GoogleButton">
			<templateVar name="$spritePath" equals="'google/google_button_'" />
			<position relativeTo="element:parent()" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<touchComponent name="Touch">
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					menu:popPopUp()
					game.logEvent("login_type_select", "login_method", game.getLoginMethodName(game.UserData_TYPE_GOOGLE), "last_login_method", game.lastLoginMethodName())
					game.authAccountIfExists(game.UserData_TYPE_GOOGLE)
				</event>
			</touchComponent>
			<event name="onPostInit" params="element">
				if game.canLoginToLoginType(game.UserData_TYPE_GOOGLE) == false or not game.googleSignInAvailable() then
					element:DoStoredScript("setInvisible")
				elseif game.lastLoginMethodType() == game.UserData_TYPE_GOOGLE then
					element:DoStoredScript("showHighlight")
				end
			</event>
		</template>

		<template type="template_login_button" name="AmazonButton">
			<templateVar name="$spritePath" equals="'amazon/amazon_button_'" />
			<position relativeTo="element:parent()" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<touchComponent name="Touch">
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					menu:popPopUp()
					game.logEvent("login_type_select", "login_method", game.getLoginMethodName(game.UserData_TYPE_AMAZON), "last_login_method", game.lastLoginMethodName())
					game.authAccountIfExists(game.UserData_TYPE_AMAZON)
				</event>
			</touchComponent>
			<event name="onPostInit" params="element">
				if game.canLoginToLoginType(game.UserData_TYPE_AMAZON) == false  or not game.loginWithAmazonAvailable() then
					element:DoStoredScript("setInvisible")
				elseif game.lastLoginMethodType() == game.UserData_TYPE_AMAZON then
					element:DoStoredScript("showHighlight")
				end
			</event>
		</template>

		<template type="template_login_button" name="GameCenterButton">
			<templateVar name="$spritePath" equals="'gamecenter/gamecenter_button_'" />
			<position relativeTo="element:parent()" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<touchComponent name="Touch">
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					menu:popPopUp()
					game.logEvent("login_type_select", "login_method", game.getLoginMethodName(game.UserData_TYPE_GAME_CENTER), "last_login_method", game.lastLoginMethodName())
					game.authAccountIfExists(game.UserData_TYPE_GAME_CENTER)
				</event>
			</touchComponent>
			<event name="onPostInit" params="element">
				if game.canLoginToLoginType(game.UserData_TYPE_GAME_CENTER) == false then
					element:DoStoredScript("setInvisible")
				elseif game.lastLoginMethodType() == game.UserData_TYPE_GAME_CENTER then
					element:DoStoredScript("showHighlight")
				end
			</event>
		</template>

		<template type="template_login_button" name="GuestButton">
			<templateVar name="$spritePath" equals="'guest/guest_button_'" />
			<position relativeTo="element:parent()" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<touchComponent name="Touch">
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					menu:popPopUp()
					game.logEvent("login_type_select", "login_method", game.getLoginMethodName(game.UserData_TYPE_ANON), "last_login_method", game.lastLoginMethodName())
					game.authAccountIfExists(game.UserData_TYPE_ANON)
				</event>
			</touchComponent>
			<event name="onPostInit" params="element">
				if game.canLoginToLoginType(game.UserData_TYPE_ANON) == false then
					element:DoStoredScript("setInvisible")
				elseif game.lastLoginMethodType() == game.UserData_TYPE_ANON then
					element:DoStoredScript("showHighlight")
				end
			</event>
		</template>

		<template type="template_login_button" name="EmailButton">
			<templateVar name="$spritePath" equals="'email/email_button_'" />
			<position relativeTo="element:parent()" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<touchComponent name="Touch">
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					menu:popPopUp()
					game.logEvent("login_type_select", "login_method", game.getLoginMethodName(game.UserData_TYPE_EMAIL), "last_login_method", game.lastLoginMethodName())
					menu:pushPopUp("login_email")
				</event>
			</touchComponent>
			<event name="onPostInit" params="element">
				if game.canLoginToLoginType(game.UserData_TYPE_EMAIL) == false then
					element:DoStoredScript("setInvisible")
				elseif game.lastLoginMethodType() == game.UserData_TYPE_EMAIL then
					element:DoStoredScript("showHighlight")
				end
			</event>
		</template>

		<template type="template_spritesheetbutton" name="SteamButton">
			<templateVar name="$upSpriteName" equals="'button_continue'" />
			<templateVar name="$sheetName" equals="'xml_resources/buttons01.xml'" />
			<templateVar name="$spriteScale" equals="0.6*game.hudScale()" />
			<templateVar name="$layer" equals="MidPopUps" />
			<position relativeTo="element:parent()" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<textComponent name="Label">
				<size w="115*game.hudScale()" h="30*game.hudScale()"/>
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("multiline"):SetInt(0)
					component("font"):Set(game.getTextFont())
					component("size"):SetFloat(0.25*game.hudScale())
					component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
					component("text"):SetString("BUTTON_STEAM_LABEL")
					component("autoScale"):SetInt(1)
					component("layer"):SetString("MidPopUps")
				</event>
			</textComponent>
			<touchComponent name="Touch">
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					game.logEvent("login_type_select", "login_method", game.getLoginMethodName(game.UserData_TYPE_STEAM), "last_login_method", game.lastLoginMethodName())
					game.authAccountIfExists(game.UserData_TYPE_STEAM)
					menu:popPopUp()
				</event>
			</touchComponent>
			<event name="onPostInit" params="element">
				if game.canLoginToLoginType(game.UserData_TYPE_STEAM) == false then
					element:DoStoredScript("setInvisible")
					element:C("Label"):V("visible"):SetInt(0)
				end
			</event>
		</template>

	</element>
	
	<element name="LastLogin">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="Frame" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0*game.hudScale()" yOffset="-30*game.hudScale()" priorityOffset="-1" />
		<textComponent name="Text">
			<size w="275*game.hudScale()" h="20*game.hudScale()" />
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.25*game.hudScale())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString(game.getLocalizedText("LAST_LOGIN_LABEL").." "..game.getLocalizedText(game.lastLoginMethodName()))
				component("autoScale"):SetInt(1)
				component("layer"):SetString("MidPopUps")
			</event>
		</textComponent>
	</element>

	<template type="template_spritesheetbutton" name="FacebookButton">
		<templateVar name="$upSpriteName" equals="'button_continue'" />
		<templateVar name="$sheetName" equals="'xml_resources/buttons01.xml'" />
		<templateVar name="$spriteScale" equals="0.6*game.hudScale()" />
		<templateVar name="$layer" equals="MidPopUps" />
		<position relativeTo="SAFE_AREA" vAnchor="BOTTOM" hAnchor="LEFT" />
		<orientation vAnchor="BOTTOM" hAnchor="LEFT" xOffset="5*game.menuScaleX()" yOffset="5*game.menuScaleY()"  priorityOffset="7" />
		<textComponent name="Label">
			<size w="145*game.hudScale()" h="30*game.hudScale()"/>
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(1)
				component("font"):Set(game.getTitleFont())
				component("size"):SetFloat(0.25*game.hudScale())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString("RECOVER_FACEBOOK_ACCOUNT")
				component("autoScale"):SetInt(1)
				component("layer"):SetString("MidPopUps")
			</event>
		</textComponent>
		<touchComponent name="Touch">
			<event name="onTouchDown" params="component, element">
				onTouchDown(component, element)
				element["Label"]:setColor(0.5, 0.5, 0.5)
			</event>
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element["Label"]:setColor(1.0, 1.0, 1.0)
				game.displayConfirmation("FACEBOOK_LOGIN_HELP", game.getLocalizedText("NOTIFICATION_FACEBOOK_AUTHORIZATION_FAILED"))
				--menu:popPopUp()
			</event>
			<event name="onTouchRelease" params="component, element">
				onTouchRelease(component, element)
				element["Label"]:setColor(1.0, 1.0, 1.0)
			</event>
		</touchComponent>
		<spriteSheetComponent name="UpSprite">
			<event name="onInit" params="component, element">
				onInit(component, element)
			</event>
		</spriteSheetComponent>
	</template>

	<template type="template_spritesheetbutton" name="BackButton">
		<templateVar name="$layer" equals="MidPopUps" />
		<templateVar name="$spriteScale" equals="0.5*game.hudScale()" />
		<templateVar name="$buttonMapping" equals="game.cancelButton()" />
		<position relativeTo="SAFE_AREA" vAnchor="BOTTOM" hAnchor="RIGHT" />
		<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="2*game.hudScale()" yOffset="0*game.hudScale()" priorityOffset="7" />
		<touchComponent name="Touch">
			<event name="onTouchDown" params="component, element">
				onTouchDown(component, element)
				element["Overlay"]:setColor(0.5, 0.5, 0.5)
			</event>
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
				menu:popPopUp()
				menu:pushPopUp("login_start")
			</event>
			<event name="onTouchRelease" params="component, element">
				onTouchRelease(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
			</event>
		</touchComponent>
		<spriteSheetComponent name="Overlay">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_back")
				component("sheetName"):SetString("xml_resources/context_buttons.xml")
				component("size"):SetFloat(0.5*game.hudScale())
				component("layer"):SetString("MidPopUps")
			</event>
		</spriteSheetComponent>
		<event name="onTick" params="element, dt">
			onTick(element, dt)
			if(element["UpSprite"]("size"):GetFloat() ~= element["Overlay"]("size"):GetFloat()) then
				element["Overlay"]("size"):SetFloat(element["UpSprite"]("size"):GetFloat())
			end
		</event>
	</template>
	
	<event name="queuePop" params="element">
		element("transitionState"):SetInt(2)
	</event>

	<element name="LayoutHelper">
		<event name="onPostInit" params="element">
				<![CDATA[ 
					element:Refresh()
				]]>
			</event>
			<event name="Refresh" params="element">
				<![CDATA[ 
					local MenuHelpers = include("MenuHelpers")
					local spacer = MenuHelpers.CreateSpacer(0, 4*game.hudScale())
					local numItems = 0

					local items = {}
					local function insertIfVisible(item)
						if item.isVisible then

							if numItems > 0 then
								table.insert(items, spacer)	
							end

							table.insert(items, item)
							numItems = numItems + 1
						end
					end

					insertIfVisible(element:parent().Buttons.AppleButton)
					insertIfVisible(element:parent().Buttons.AmazonButton)
					insertIfVisible(element:parent().Buttons.GoogleButton)
					insertIfVisible(element:parent().Buttons.GameCenterButton)
					insertIfVisible(element:parent().Buttons.EmailButton)
					insertIfVisible(element:parent().Buttons.GuestButton)
					insertIfVisible(element:parent().Buttons.SteamButton)

					MenuHelpers.CenterVertically(items)
				]]>
			</event>
	</element>
	
</menu>