<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">
	
	<template type="template_fade" name="FadedBG">
		<templateVar name="$layer" equals="FrontPopUps" />
		<templateVar name="$priority" equals="11" />
		<templateVar name="$touchPriority" equals="-7" /> <!-- relative to priority -->		
		<templateVar name="$maxAlpha" equals="0.75" />
	</template>
	
	<template type="template_currency_counter_manager" name="CurrencyCounters">
		<templateVar name="$layer" equals="FrontPopUps" />
		<position relativeTo="PARENT" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="0" yOffset="0" priorityOffset="2" />
		<event name="onInit" params="element">
			<![CDATA[
				onInit(element)
				
				element.currencyOptions[game.CurrencyType_MinigameTokens].ViewState = element.VIEW_STATE.ALWAYS
				element.currencyOptions[game.CurrencyType_MinigameTokens].Sorting = 1

				element.currencyOptions[game.CurrencyType_Diamonds].ViewState = element.VIEW_STATE.ALWAYS
				element.currencyOptions[game.CurrencyType_Diamonds].Sorting = 2
			]]>
		</event>
	</template>
	
	<template type="template_panel_decorated" name="Frame">
		<templateVar name="$layer" equals="FrontPopUps" />
		<size w="240*game.windowScaleY()" h="180*game.windowScaleY()" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="screenHeight() * 2.0" priorityOffset="10" />

		<event name="onInit" params="element">
			onInit(element)
			element.onDoneHide = function()
				element:root():removePopUp(element:parent():name())
			end
		</event>
	</template>
		
	<element name="TitleFrame">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="Frame" vAnchor="TOP" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
		<ninesliceComponent name="Sprite">
			<size w="140*game.windowScaleY()" h="30*game.windowScaleY()" />
			<event name="onInit" params="component, element">
				component("topHeight"):SetFloat(40.0)
				component("bottomHeight"):SetFloat(40.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("size"):SetFloat(0.25*game.windowScaleY())
				component("includeBorder"):SetInt(1)
				component("spriteName"):SetString("gfx/menu/GreyTitleFrame")
				component("layer"):SetString("FrontPopUps")
			</event>
		</ninesliceComponent>
	</element>
	
	<element name="TitleLabel">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="TitleFrame" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
		<textComponent name="Text">
			<size w="130*game.windowScaleY()" h="18*game.windowScaleY()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				local palette = include("ColourPalette")
				component:setColor(palette:getRGBFloats(palette.TITLE_GREEN_2))
				component("size"):SetFloat(0.45*game.windowScaleY())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString(game.localizedUpper(game.getLocalizedText("MINIGAME_BONUS_TITLE")))
				component("autoScale"):SetInt(1)
				component("layer"):SetString("FrontPopUps")
			</event>
		</textComponent>
	</element>
	
	<element name="Notification">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="TitleFrame" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="5*game.windowScaleY()" priorityOffset="-1" />
		<textComponent name="Text">
			<size w="220*game.windowScaleY()" h="40*game.windowScaleY()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(1)
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.25*game.windowScaleY())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("layer"):SetString("FrontPopUps")
				component("text"):SetString("MINIGAME_BONUS_BODY")
				component("autoScale"):SetInt(1)
			</event>
		</textComponent>
	</element>

	<template type="template_reward_list" name="Rewards">
		<!-- show bundle contents-->
		<templateVar name="$scale" equals="0.6*game.windowScaleY()/game.hudScale()"/><!-- down the chain everything gets multiplied by windowScaleY which is no bueno-->
		<templateVar name="$layer" equals="FrontPopUps"/>
		<size w="230*game.windowScaleY()" h="120*game.windowScaleY()" />
		<position relativeTo="Frame" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-4*game.windowScaleY()" priorityOffset="-1" />
	</template>
	
	<template type="template_spritesheetbutton" name="DiamondsButton">
		<hudScale scale="game.hudScale()" />
		<templateVar name="$text" equals="BUY_BUTTON" />
		<templateVar name="$font" equals="'game.getTitleFont()'" />
		<templateVar name="$spriteScale" equals="0.5" />
		<templateVar name="$layer" equals="FrontPopUps" />
		<templateVar name="$buttonMapping" equals="game.confirmButton()" />
		<position relativeTo="Frame" vAnchor="BOTTOM" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="60/game.hudScale()" yOffset="-10/game.hudScale()" priorityOffset="-1" />
		<textComponent name="Text">
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" />
			<event name="onInit" params="component, element">
				onInit(component, element)
				component("size"):SetFloat(0.25)
			</event>
		</textComponent>
		<touchComponent name="Touch">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-6" />
			<event name="onTouchDown" params="component, element">
				onTouchDown(component, element)
				element["Overlay"]:setColor(0.5, 0.5, 0.5)
			</event>
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
				game.minigameContext():doBonus(2)
				element:parent():E("FadedBG"):Hide()
				element:parent():E("Frame"):Hide()
			</event>
			<event name="onTouchRelease" params="component, element">
				onTouchRelease(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
			</event>
		</touchComponent>
		<spriteSheetComponent name="Overlay">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_replay")
				component("sheetName"):SetString("xml_resources/context_buttons.xml")
				component("layer"):SetString("FrontPopUps")
				component("size"):SetFloat(0.5)
			</event>
		</spriteSheetComponent>
		<textComponent name="PriceText">
			<position relativeTo="element:name()" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="0" />
			<event name="onInit" params="component, element">
				component("font"):SetString(game.getTitleFont())
				component("size"):SetFloat(0.3)
				component("autoScale"):SetFloat(0)
				component("text"):SetString("-" .. game.minigameContext():minigameBonusDiamondCost())
				game.StoreContext_setDiamondTextColour(component)
				component("layer"):SetString("FrontPopUps")
				component("multiline"):SetInt(0)
			</event>
		</textComponent>
		<event name="onTick" params="element, dt">
			onTick(element, dt)
			if(element["UpSprite"]("size"):GetFloat() ~= element["Overlay"]("size"):GetFloat()) then
				element["Overlay"]("size"):SetFloat(element["UpSprite"]("size"):GetFloat())
			end
		</event>
	</template>
	
	<template type="template_spritesheetbutton" name="AdButton">
		<hudScale scale="game.hudScale()" />
		<templateVar name="$text" equals="CONTEXTBAR_WATCH_LABEL" />
		<templateVar name="$font" equals="'game.getTitleFont()'" />
		<templateVar name="$spriteScale" equals="0.5" />
		<templateVar name="$layer" equals="FrontPopUps" />
		<templateVar name="$buttonMapping" equals="game.confirmButton()" />
		<position relativeTo="Frame" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-10/game.hudScale()" priorityOffset="-1" />
		<textComponent name="Text">
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" />
			<event name="onInit" params="component, element">
				onInit(component, element)
				component("size"):SetFloat(0.25)
			</event>
		</textComponent>
		<touchComponent name="Touch">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-6" />
			<event name="onTouchDown" params="component, element">
				onTouchDown(component, element)
				element["Overlay"]:setColor(0.5, 0.5, 0.5)
			</event>
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
				game.minigameContext():doBonus(1)
				element:parent():E("FadedBG"):Hide()
				element:parent():E("Frame"):Hide()
			</event>
			<event name="onTouchRelease" params="component, element">
				onTouchRelease(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
			</event>
		</touchComponent>
		<spriteSheetComponent name="Overlay">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_replay_ad")
				component("sheetName"):SetString("xml_resources/buttons02.xml")
				component("layer"):SetString("FrontPopUps")
				component("size"):SetFloat(0.5)
			</event>
		</spriteSheetComponent>
		<event name="onTick" params="element, dt">
			onTick(element, dt)
			if(element["UpSprite"]("size"):GetFloat() ~= element["Overlay"]("size"):GetFloat()) then
				element["Overlay"]("size"):SetFloat(element["UpSprite"]("size"):GetFloat())
			end
		</event>
		<event name="setInvisible" params="element">
			setInvisible(element)
			element["Overlay"]("visible"):SetInt(0)
		</event>
		<event name="setVisible" params="element">
			setVisible(element)
			element["Overlay"]("visible"):SetInt(1)
		</event>
	</template>
	
	<template type="template_spritesheetbutton" name="DismissButton">
		<hudScale scale="game.hudScale()" />
		<templateVar name="$text" equals="CONTEXTBAR_CLOSE_LABEL" />
		<templateVar name="$font" equals="'game.getTitleFont()'" />
		<templateVar name="$spriteScale" equals="0.5" />
		<templateVar name="$layer" equals="FrontPopUps" />
		<templateVar name="$buttonMapping" equals="game.cancelButton()" />
		<position relativeTo="Frame" vAnchor="BOTTOM" hAnchor="RIGHT" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-60/game.hudScale()" yOffset="-10/game.hudScale()" priorityOffset="-1" />
		<textComponent name="Text">
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" />
			<event name="onInit" params="component, element">
				onInit(component, element)
				component("size"):SetFloat(0.25)
			</event>
		</textComponent>
		<touchComponent name="Touch">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-6" />
			<event name="onTouchDown" params="component, element">
				onTouchDown(component, element)
				element["Overlay"]:setColor(0.5, 0.5, 0.5)
			</event>
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
				game.minigameContext():doBonus(0)
				element:parent():E("FadedBG"):Hide()
				element:parent():E("Frame"):Hide()
			</event>
			<event name="onTouchRelease" params="component, element">
				onTouchRelease(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
			</event>
		</touchComponent>
		<spriteSheetComponent name="Overlay">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_no")
				component("sheetName"):SetString("xml_resources/context_buttons.xml")
				component("layer"):SetString("FrontPopUps")
				component("size"):SetFloat(0.5)
			</event>
		</spriteSheetComponent>
		<event name="onTick" params="element, dt">
			onTick(element, dt)
			if(element["UpSprite"]("size"):GetFloat() ~= element["Overlay"]("size"):GetFloat()) then
				element["Overlay"]("size"):SetFloat(element["UpSprite"]("size"):GetFloat())
			end
		</event>
		<event name="disable" params="element">
			disable(element)
			element["Overlay"]:setColor(0.5, 0.5, 0.5)
		</event>
	</template>

	<event name="onPostInit" params="element">
		element:E("FadedBG"):Show()
		element:E("Frame"):Show()
		lua_sys.playSoundFx("audio/sfx/menu_slide.wav")
		
		if not game.hasAds() then
			element:E("Notification"):C("Text")("text"):SetString("MINIGAME_BONUS_BODY_PC")
			element:E("AdButton"):DoStoredScript("setInvisible")
		end

		local parsedRewards = {{
			type = game.LootType_MinigameTokens,
			amount = game.minigameContext():minigameBonusTokenAmount(),
		}}

		element:E("Rewards"):populate(parsedRewards)
	</event>
</menu>