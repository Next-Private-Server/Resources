			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onTouchDown" params="component, element">
				element["BackingSprite"]:setColor(0.5, 0.5, 0.5)
				element["Rarity"]:setColor(0.5, 0.5, 0.5)
				element["Arrow"]:setColor(0.5, 0.5, 0.5)
				element("ButtonState"):SetInt(game.BUTTON_PRESSED)
				element("TickTimer"):SetFloat(0.0)
			</event>
			<event name="onTouchUp" params="component, element">			
				<![CDATA[
					element["BackingSprite"]:setColor(1.0, 1.0, 1.0)
					element["Rarity"]:setColor(1.0, 1.0, 1.0)
					element["Arrow"]:setColor(1.0, 1.0, 1.0)
					element("ButtonState"):SetInt(game.BUTTON_RELEASED)
					element("TickTimer"):SetFloat(0.0)
					element:parent().PreviousPage(component, element)
				]]>
			</event>
			<event name="onTouchRelease" params="component, element">
				element["BackingSprite"]:setColor(1.0, 1.0, 1.0)
				element["Rarity"]:setColor(1.0, 1.0, 1.0)
				element["Arrow"]:setColor(1.0, 1.0, 1.0)
				element("ButtonState"):SetInt(game.BUTTON_RELEASED)
				element("TickTimer"):SetFloat(0.0)
			</event>
		</touchComponent>
		<event name="hide" params="element">
			element["BackingSprite"]("visible"):SetInt(0)
			element["Rarity"]("visible"):SetInt(0)
			element["Arrow"]("visible"):SetInt(0)
			element["Touch"]("enabled"):SetInt(0)
		</event>
		<event name="show" params="element">
			element["BackingSprite"]("visible"):SetInt(1)
			element["Rarity"]("visible"):SetInt(1)
			element["Arrow"]("visible"):SetInt(1)
			element["Touch"]("enabled"):SetInt(1)
		</event>
		<event name="onInit" params="element">
			element("ButtonState"):SetInt(game.BUTTON_IDLE)
			element("TickTimer"):SetFloat(0.0)
		</event>
		<event name="onTick" params="element, dt">
			element:parent().DoPageButtonEffect(element, dt)
		</event>
	</element>


