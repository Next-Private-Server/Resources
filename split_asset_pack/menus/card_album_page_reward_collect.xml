<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">
	<script src="scripts/CardAlbumPageRewardCollect.lua"/>
	
	<template type="template_fade" name="Fade">
		<templateVar name="$layer" equals="Tutorial" />
		<templateVar name="$priority" equals="20" />
		<templateVar name="$touchPriority" equals="-18" /> <!-- relative to priority -->
		<templateVar name="$maxAlpha" equals="0.75" />
		<templateVar name="$autoShow" equals="1"/>
		<touchComponent name="Touch"/>
	</template>

	<element name="TitleFrame">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" component="Anim" vAnchor="TOP" hAnchor="HCENTER" />
		<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="-60*game.windowScaleY()" priorityOffset="-1" />
		<ninesliceComponent name="Sprite">
			<size w="230*game.windowScaleY()" h="35*game.windowScaleY()" />
			<event name="onInit" params="component, element">
				component("topHeight"):SetFloat(50.0)
				component("bottomHeight"):SetFloat(50.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("size"):SetFloat(0.35*game.windowScaleY())
				component("includeBorder"):SetInt(1)
				component("spriteName"):SetString("gfx/menu/GreyTitleFrame")
				component("layer"):SetString("Tutorial")
			</event>
		</ninesliceComponent>
	</element>

	<spriteSheetComponent name="CardsLeft">
		<position relativeTo="TitleFrame" vAnchor="VCENTER" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-6*game.windowScaleY()" yOffset="0" priorityOffset="-1" />
		<event name="onInit" params="component, element">
			component("spriteName"):SetString("card_header_left")
			component("sheetName"):SetString("xml_resources/page_completesheet.xml")
			component("size"):SetFloat(0.35*game.windowScaleY())
			component("layer"):SetString("Tutorial")
		</event>
	</spriteSheetComponent>

	<spriteSheetComponent name="CardsRight">
		<position relativeTo="TitleFrame" vAnchor="VCENTER" hAnchor="RIGHT" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="6*game.windowScaleY()" yOffset="0" priorityOffset="-1" />
		<event name="onInit" params="component, element">
			component("spriteName"):SetString("card_header_right")
			component("sheetName"):SetString("xml_resources/page_completesheet.xml")
			component("size"):SetFloat(0.35*game.windowScaleY())
			component("layer"):SetString("Tutorial")
		</event>
	</spriteSheetComponent>

	<element name="TitleText">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="TitleFrame" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0*game.windowScaleY()" priorityOffset="-1" />
		<textComponent name="Text">
			<size w="180*game.windowScaleY()" h="30*game.windowScaleY()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				local palette = include("ColourPalette")
				component:setColor(palette:getRGBFloats(palette.TITLE_YELLOW))
				component("size"):SetFloat(0.45*game.windowScaleY())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString(game.localizedUpper("CARD_ALBUM_PAGE_COMPLETE"))
				component("autoScale"):SetInt(1)
				component("layer"):SetString("Tutorial")
			</event>
		</textComponent>
	</element>

	<aeComponent name="Anim">
		<size w="200*game.windowScaleY()" h="200*game.windowScaleY()" />
		<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-15*game.windowScaleY()" priorityOffset="19" />
		<event name="onInit" params="component, element">
			<![CDATA[
				component("offsetCenter"):SetInt(1)
				local cardAlbum = game.player():currentlyActiveCardAlbum()
				local cardAlbumId = cardAlbum:cardAlbumId()
				--need to add a new anim file for each album that points to the stickers_album_sheet_{cardAlbumId}.xml
				local animationFile = string.format("xml_bin/page_complete_anim_%02d.bin", cardAlbumId)
				component("animationName"):SetString(animationFile)
				component("animation"):SetString("page_complete")
				component:setScale(Vector2(0.38*game.windowScaleY(), 0.38*game.windowScaleY()))
				component("layer"):SetString("Tutorial")
			]]>
		</event>
	</aeComponent>
	
	<textComponent name="Text">
		<size w="70*game.windowScaleY()" h="12*game.windowScaleY()" />
		<position relativeTo="PARENT" component="Anim" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="47*game.windowScaleY()" priorityOffset="-1" />
		<event name="onInit" params="component, element">
			component("multiline"):SetInt(0)
			component("font"):Set(game.getTextFont())
			component("size"):SetFloat(0.3*game.windowScaleY())
			component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
			component("text"):SetString("Page name")
			component("autoScale"):SetInt(1)
			component("autoScaleFactor"):SetFloat(0.01)
			component("layer"):SetString("Tutorial")
		</event>
	</textComponent>


	<template type="template_nineslicebutton" name="CollectButton">
		<templateVar name="$upSpriteName" equals="'gfx/menu/button_green_gem'" />
		<templateVar name="$spriteScale" equals="0.4*game.windowScaleY()" />
		<templateVar name="$text" equals="CARD_ALBUM_REWARD_COLLECT" />
		<templateVar name="$font" equals="'game.getTitleFont()'" />
		<templateVar name="$textPadding" equals="4*game.windowScaleY()" />
		<templateVar name="$autoScaleFactor" equals="0.01" />
		<templateVar name="$topHeight" equals="30.0" />
		<templateVar name="$bottomHeight" equals="30.0" />
		<templateVar name="$leftWidth" equals="35.0" />
		<templateVar name="$rightWidth" equals="35.0" />
		<templateVar name="$width" equals="95*game.windowScaleY()" />
		<templateVar name="$height" equals="28*game.windowScaleY()" />
		<templateVar name="$includeBorder" equals="1" />	
		<templateVar name="$layer" equals="Tutorial" />
		<position relativeTo="PARENT" component="Anim" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="10*game.windowScaleY()" priorityOffset="-1" />

		<textComponent name="Text">
			<event name="onInit" params="component, element">
				onInit(component, element)
				component("size"):SetFloat(0.18*game.windowScaleY())
			</event>
		</textComponent>
		<touchComponent name="Touch">
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-18" />
			<event name="onInit" params="component, element">
				onInit(component, element)
				component("enabled"):SetInt(0)
			</event>
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element:parent():collectReward()
			</event>
		</touchComponent>

		<event name="setAlpha" params="element, alpha">		
			element["BoundsSprite"]:V("alpha"):SetFloat(alpha)
			element["UpSprite"]:V("alpha"):SetFloat(alpha)
			element["DownSprite"]:V("alpha"):SetFloat(alpha)
			element["Text"]:V("alpha"):SetFloat(alpha)
		</event>
	</template>


</menu>