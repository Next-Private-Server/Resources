				component:setColor(0.31, 0.94, 0.26)
				component("layer"):SetString("FrontPopUps")
			</event>
		</textComponent>
		<touchComponent name="BBBIdTouch">
			<size dependentOnElement="element:name()" dependentOnComponent="BBBId" />
			<position relativeTo="element[&quot;BBBId&quot;]" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-3" />
			<event name="onInit" params="component, element">
				element.touchTimer = 0
				element.holding = false
				element.copiedDone = false
			</event>
			<event name="onTouchDown" params="component, element">
				<![CDATA[
					element.holding = true
					element.touchTimer = 0
				]]>
			</event>
			<event name="onTouchUp" params="component, element">

				element.copiedDone = false
				element.holding = false
			</event>
			<event name="onTouchRelease" params="component, element">
				<![CDATA[
					element.copiedDone = false
					element.holding = false
				]]>
			</event>
			<event name="onTouchDrag" params="component, element, x, y, relX, relY, dx, dy">
				<![CDATA[
					if relX*relX + relY*relY > 64 then
						element.copiedDone = false
						element.holding = false
					end
				]]>
			</event>
			<event name="onTick" params="component, element, dt">
				<![CDATA[
					if element.holding then
						element.touchTimer = element.touchTimer + dt
						if element.touchTimer > 0.75 and not element.copiedDone then
							game.setClipboardText(game.playerBBBId(), "BBBId")
							element.copiedDone = true
							element.holding = false
						end
					end
				]]>
			</event>

		</touchComponent>
		<textComponent name="BBBLabel">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
