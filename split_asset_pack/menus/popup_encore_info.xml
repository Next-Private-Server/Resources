<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">

	<element name="FadedBG">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="8" />
		<spriteComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("__BUILTIN__WHITE_TEXTURE")
				component:setScale(Vector2(lua_sys.screenWidth()*0.25, lua_sys.screenHeight()*0.25))
				local palette = include("ColourPalette")
				component:setColor(palette:getRGBFloats(palette.FADED_BG_COLOUR))
				component("alpha"):SetFloat(0.5)
				component("layer"):SetString("MidFrontPopUps")
			</event>
		</spriteComponent>
		<touchComponent name="Touch">
			<size dependentOnElement="element:name()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-4" />
		</touchComponent>
	</element>

	<element name="bg">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="7" />
		<ninesliceComponent name="Sprite">
			<size w="360*game.windowScaleMin()" h="280*game.windowScaleMin()" />
			<event name="onInit" params="component, element">
				component("topHeight"):SetFloat(50.0)
				component("bottomHeight"):SetFloat(50.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("size"):SetFloat(0.3*game.windowScaleMin())
				component("includeBorder"):SetInt(1)
				component("spriteName"):SetString("gfx/menu/Black9SFrame50")
				component("layer"):SetString("MidFrontPopUps")
			</event>
		</ninesliceComponent>
	</element>

	<event name="onPostInit" params="element">
	<![CDATA[
		if game.getContextBar() then
			-- hide it
			element.lastContext = game.getContextBar():getContext()
			game.getContextBar():setContext("BLANK")
		end

		local encoreType = game.EncoreType_All
		if (not game.isMemberOfGroup(70)) then
			local encoreEvent = game.getCurrentEncoreEvent()

			if encoreEvent == nil then
				element:queuePop()
				return
			end

			encoreType = encoreEvent:getEncoreType()
		end

		if (encoreType == game.EncoreType_Baking) then
			element:E("TitleFrame"):C("Text")("text"):SetString("ENCORE_INFO_TITLE_BAKING")

			element:E("TopText"):C("Text")("text"):SetString("ENCORE_INFO_THEME_BAKING")
			element:E("TopText"):C("Sprite")("spriteName"):SetString("encore_icon_bake")

			element:C("BottomText")("text"):SetString("ENCORE_INFO_DESC_BAKING")

			element:C("CenterImage")("spriteName"):SetString("encore_image_baking")
			element:C("CenterImage")("sheetName"):SetString("xml_resources/encore_popup_sheet01.xml")

			element:C("BottomLeftImage")("spriteName"):SetString("encore_baking_decoration_01")
			element:C("BottomLeftImage")("sheetName"):SetString("xml_resources/encore_popup_sheet01.xml")

		elseif (encoreType == game.EncoreType_Breeding) then
			element:E("TitleFrame"):C("Text")("text"):SetString("ENCORE_INFO_TITLE_BREEDING")

			element:E("TopText"):C("Text")("text"):SetString("ENCORE_INFO_THEME_BREEDING")
			element:E("TopText"):C("Sprite")("spriteName"):SetString("encore_icon_breed")

			element:C("BottomText")("text"):SetString("ENCORE_INFO_DESC_BREEDING")

			element:C("CenterImage")("spriteName"):SetString("encore_image_breeding")
			element:C("CenterImage")("sheetName"):SetString("xml_resources/encore_popup_sheet01.xml")

			element:C("BottomLeftImage")("spriteName"):SetString("encore_breeding_decoration_01")
			element:C("BottomLeftImage")("sheetName"):SetString("xml_resources/encore_popup_sheet01.xml")

		elseif (encoreType == game.EncoreType_Hatching) then
			element:E("TitleFrame"):C("Text")("text"):SetString("ENCORE_INFO_TITLE_HATCHING")

			element:E("TopText"):C("Text")("text"):SetString("ENCORE_INFO_THEME_HATCHING")
			element:E("TopText"):C("Sprite")("spriteName"):SetString("encore_icon_hatch")

			element:C("BottomText")("text"):SetString("ENCORE_INFO_DESC_HATCHING")

			element:C("CenterImage")("spriteName"):SetString("encore_image_hatching")
			element:C("CenterImage")("sheetName"):SetString("xml_resources/encore_popup_sheet02.xml")

			element:C("BottomLeftImage")("spriteName"):SetString("encore_hatching_decoration_01")
			element:C("BottomLeftImage")("sheetName"):SetString("xml_resources/encore_popup_sheet02.xml")

		elseif (encoreType == game.EncoreType_All) then
			element:E("TitleFrame"):C("Text")("text"):SetString("ENCORE_INFO_TITLE_ALL")

			element:E("TopText"):C("Text")("text"):SetString("ENCORE_INFO_THEME_ALL")
			element:E("TopText"):C("Sprite")("spriteName"):SetString("encore_icon_allevents")

			element:C("BottomText")("text"):SetString("ENCORE_INFO_DESC_ALL")

			element:C("CenterImage")("spriteName"):SetString("encore_image_all")
			element:C("CenterImage")("sheetName"):SetString("xml_resources/encore_popup_sheet02.xml")

			element:C("BottomLeftImage")("spriteName"):SetString("encore_all_decoration_01")
			element:C("BottomLeftImage")("sheetName"):SetString("xml_resources/encore_popup_sheet02.xml")

		else
			element:popPopUp()
			return

		end
	]]>
	</event>

	<element name="TitleFrame">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="bg" vAnchor="TOP" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
		<ninesliceComponent name="Sprite">
			<size w="200*game.windowScaleMin()" h="30*game.windowScaleMin()" />
			<event name="onInit" params="component, element">
				component("topHeight"):SetFloat(49.0)
				component("bottomHeight"):SetFloat(49.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("size"):SetFloat(0.3*game.windowScaleMin())
				component("includeBorder"):SetInt(1)
				component("spriteName"):SetString("gfx/menu/GreyTitleFrame")
				component("layer"):SetString("MidFrontPopUps")
			</event>
		</ninesliceComponent>
		<textComponent name="Text">
			<size dependentOnElement="element:name()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("textPadding"):SetInt(4)
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				component("size"):SetFloat(0.3*game.windowScaleMin())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED);
				component("text"):SetString("ENCORE_INFO_TITLE_BAKING")
				component("autoScale"):SetInt(1)
				component("layer"):SetString("MidFrontPopUps")
			</event>
		</textComponent>
	</element>

	<element name="TopText">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="TitleFrame" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="-8*game.windowScaleMin()" yOffset="6*game.windowScaleMin()" priorityOffset="0" />
		<textComponent name="Text">
			<size w="160*game.windowScaleMin()" />
			<position relativeTo="element" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("autoScale"):SetInt(1)
				component("font"):Set(game.getTextFont())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString("ENCORE_INFO_THEME_BAKING")
				component("size"):SetFloat(0.28*game.windowScaleMin())
				component("layer"):SetString("MidFrontPopUps")
				component:calculatePosition()
			</event>
		</textComponent>

		<spriteSheetComponent name="Sprite">
			<position relativeTo="element" vAnchor="VCENTER" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="2*game.windowScaleMin()" yOffset="2*game.windowScaleMin()" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("goal_icon_breed")
				component("sheetName"):SetString("xml_resources/hud03.xml")
				component("size"):SetFloat(0.3*game.windowScaleMin())
				component("layer"):SetString("MidFrontPopUps")
			</event>
		</spriteSheetComponent>
	</element>

	<spriteSheetComponent name="CenterImage">
		<position relativeTo="bg" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-20*game.windowScaleMin()" priorityOffset="-1" />
		<event name="onInit" params="component, element">
			component("spriteName"):SetString("encore_image_baking")
			component("sheetName"):SetString("xml_resources/encore_popup_sheet01.xml")
			component("size"):SetFloat(0.35*game.windowScaleMin())
			component("layer"):SetString("MidFrontPopUps")
		</event>
	</spriteSheetComponent>

	<textComponent name="BottomText">
		<size w="300*game.windowScaleMin()"/>
		<position relativeTo="element" component="CenterImage" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="5*game.windowScaleMin()" priorityOffset="0" />
		<event name="onInit" params="component, element">
			component("multiline"):SetInt(1)
			component("autoScale"):SetInt(1)
			component("font"):Set(game.getTextFont())
			component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
			component("text"):SetString("ENCORE_INFO_DESC_BAKING")
			component("size"):SetFloat(0.23*game.windowScaleMin())
			component("layer"):SetString("MidFrontPopUps")
			component:calculatePosition()
		</event>
	</textComponent>

	<element name="ConversionInfo">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="PARENT" component="BottomText" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="-5*game.windowScaleMin()" yOffset="10*game.windowScaleMin()" priorityOffset="0" />
		<textComponent name="Text">
			<size w="80*game.windowScaleMin()"/>
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				component("font"):Set(game.getTextFont())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString("ENCORE_INFO_CONVERSION")
				component("size"):SetFloat(0.25*game.windowScaleMin())
				component("layer"):SetString("MidFrontPopUps")
				component:calculatePosition()
			</event>
		</textComponent>
		<spriteSheetComponent name="Icon">
			<position relativeTo="element" vAnchor="VCENTER" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="2*game.windowScaleMin()" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("encore_coin")
				component("sheetName"):SetString("xml_resources/hud03.xml")
				component("size"):SetFloat(0.3*game.windowScaleMin())
				component("layer"):SetString("MidFrontPopUps")
			</event>
		</spriteSheetComponent>
	</element>

	<spriteSheetComponent name="BottomLeftImage">
		<position relativeTo="bg" vAnchor="BOTTOM" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="-8*game.windowScaleMin()" yOffset="-15*game.windowScaleMin()" priorityOffset="-1" />
		<event name="onInit" params="component, element">
			component("spriteName"):SetString("encore_baking_decoration_01")
			component("sheetName"):SetString("xml_resources/encore_popup_sheet01.xml")
			component("size"):SetFloat(0.3*game.windowScaleMin())
			component("layer"):SetString("MidFrontPopUps")
		</event>
	</spriteSheetComponent>

	<template type="template_spritesheetbutton" name="InfoButton">
		<templateVar name="$layer" equals="FrontPopUps" />
		<templateVar name="$spriteScale" equals="0.5*game.hudScale()" />

		<position relativeTo="CloseButton" vAnchor="VCENTER" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="8*game.hudScale()" yOffset="0" priorityOffset="0" />

		<touchComponent name="Touch">
			<event name="onTouchDown" params="component, element">
				onTouchDown(component, element)
				element["Text"]:setColor(1.0, 1.0, 1.0)
				element["Overlay"]:setColor(0.5, 0.5, 0.5)
			</event>
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
				game.pushPopUp("popup_encore_how_it_works")
			</event>
			<event name="onTouchRelease" params="component, element">
				onTouchRelease(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
			</event>
		</touchComponent>

		<spriteSheetComponent name="Overlay">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_info2")
				component("sheetName"):SetString("xml_resources/context_buttons.xml")
				component("size"):SetFloat(0.5*game.hudScale())
				component("layer"):SetString("FrontPopUps")
			</event>
		</spriteSheetComponent>

		<textComponent name="Text">
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-12*game.hudScale()" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString("CONTEXTBAR_INFO_LABEL")
				component("size"):SetFloat(0.3*game.hudScale())
				component("layer"):SetString("FrontPopUps")
			</event>
		</textComponent>

		<event name="onTick" params="element, dt">
			onTick(element, dt)
			if(element["Overlay"]("size"):GetFloat() ~= element["UpSprite"]("size"):GetFloat()) then
				element["Overlay"]("size"):SetFloat(element["UpSprite"]("size"):GetFloat())
			end
		</event>
	</template>

	<template type="template_spritesheetbutton" name="CloseButton">
		<templateVar name="$layer" equals="FrontPopUps" />
		<templateVar name="$spriteScale" equals="0.5*game.hudScale()" />
		<templateVar name="$buttonMapping" equals="game.cancelButton()" />

		<position relativeTo="SAFE_AREA" vAnchor="BOTTOM" hAnchor="RIGHT" />
		<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="3*game.hudScale()" yOffset="12*game.hudScale()" priorityOffset="3" />

		<touchComponent name="Touch">
			<event name="onTouchDown" params="component, element">
				onTouchDown(component, element)
				element["Text"]:setColor(1.0, 1.0, 1.0)
				element["Overlay"]:setColor(0.5, 0.5, 0.5)
			</event>
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
				element:parent():queuePop()
			</event>
			<event name="onTouchRelease" params="component, element">
				onTouchRelease(component, element)
				element["Overlay"]:setColor(1.0, 1.0, 1.0)
			</event>
		</touchComponent>

		<spriteSheetComponent name="Overlay">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_no")
				component("sheetName"):SetString("xml_resources/context_buttons.xml")
				component("size"):SetFloat(0.5*game.hudScale())
				component("layer"):SetString("FrontPopUps")
			</event>
		</spriteSheetComponent>

		<textComponent name="Text">
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-12*game.hudScale()" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("text"):SetString("EXIT")
				component("size"):SetFloat(0.3*game.hudScale())
				component("layer"):SetString("FrontPopUps")
			</event>
		</textComponent>

		<event name="onTick" params="element, dt">
			onTick(element, dt)
			if(element["Overlay"]("size"):GetFloat() ~= element["UpSprite"]("size"):GetFloat()) then
				element["Overlay"]("size"):SetFloat(element["UpSprite"]("size"):GetFloat())
			end
		</event>
	</template>

	<event name="queuePop" params="element">
	<![CDATA[
		element:root():popPopUp()

		if game.getContextBar() and element.lastContext then
			game.getContextBar():setContext(element.lastContext)
		end
	]]>
	</event>

</menu>