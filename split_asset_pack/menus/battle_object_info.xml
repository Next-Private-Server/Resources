	<element name="TimeRemainingText">
		<size w="120*game.menuScaleX()" h="35*game.menuScaleY()" />
		<position relativeTo="ImageFrame" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="20*game.menuScaleY()" priorityOffset="-4" />
