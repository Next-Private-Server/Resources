<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">
	<script src="scripts/MapBase.lua"/>
	
	<element name="debugTextTop">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="SCREEN" vAnchor="TOP" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
		<textComponent name="Text">
			<size w="lua_sys.screenWidth()"/>
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				component("size"):SetFloat(0.25*game.menuScaleX())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
				component:setColor(1.0, 1.0, 1.0)
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				component("alpha"):SetFloat(0.5)
				component("layer"):SetString("Cursor")
				component("visible"):SetInt(0)
				if game.isAdmin() and game.inAdminViewMode() then
					component("text"):SetString("Admin View: "..game.getAdminViewUser())
					component("visible"):SetInt(1)
				end
				
			</event>
		</textComponent>
	</element>

	<element name="debugText">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
		<textComponent name="Text">
			<size w="lua_sys.screenWidth()"/>
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				component("size"):SetFloat(2.0*game.menuScaleX())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
				component:setColor(1.0, 1.0, 1.0)
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				component("alpha"):SetFloat(0.5)
				component("layer"):SetString("Cursor")
				component("visible"):SetInt(0)
				if game.isQABuild() then
					component("text"):SetString("QA_BUILD")
					component("visible"):SetInt(1)
				elseif game.isAdmin() and game.isDebugBuild() then
					component("text"):SetString("ADMIN")
					component("visible"):SetInt(1)
				end
				
			</event>
		</textComponent>
	</element>
	
	<element name="IslandList">
		<script src="scripts/MapIslandList.lua"/>
		<size w="420*game.mapScale()" h="lua_sys.screenHeight() - 56*game.mapScale()" />
		<position relativeTo="SCREEN" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="-24*game.mapScale()" yOffset="56*game.mapScale()" priorityOffset="20" />
		<swipeComponent name="Swiper" inline="true" requireFocus="1"/>
		<touchComponent name="Touch" inline="true" handleMouseScrollEvents="1">
			<!-- depends on size of template_map_list_entry -->
			<size w="(420-(32+24))*game.mapScale()" h="lua_sys.screenHeight()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="(32+24)*game.mapScale()" yOffset="0" priorityOffset="0" />
		</touchComponent>
	</element>

	<element name="MirrorIslandList">
		<script src="scripts/MapIslandList.lua"/>
		<size w="420*game.mapScale()" h="lua_sys.screenHeight() - 56*game.mapScale()" />
		<position relativeTo="SCREEN" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="-24*game.mapScale()" yOffset="56*game.mapScale()" priorityOffset="20" />
		<swipeComponent name="Swiper" inline="true" requireFocus="1"/>
		<touchComponent name="Touch" inline="true" handleMouseScrollEvents="1">
			<!-- depends on size of template_map_list_entry -->
			<size w="(420-(32+24))*game.mapScale()" h="lua_sys.screenHeight()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="(32+24)*game.mapScale()" yOffset="0" priorityOffset="0" />
		</touchComponent>
	</element>

	<element name="TopHUD">
		<size w="(420-24)*game.mapScale()" h="64*game.mapScale()" />
		<position relativeTo="SCREEN" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="16"/>

		<ninesliceComponent name="BG">
			<size w="640*game.mapScale()" h="240*game.mapScale()" />
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="RIGHT" />
			<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="-10*game.mapScale()" yOffset="-20*game.mapScale()" priorityOffset="0" />
			<event name="onInit" params="component, element">
				<![CDATA[
					component("topHeight"):SetFloat(110.0)
					component("bottomHeight"):SetFloat(106.0)
					component("leftWidth"):SetFloat(136.0)
					component("rightWidth"):SetFloat(149.0)
					component("size"):SetFloat(0.5*game.hudScale())
					component("includeBorder"):SetInt(1)
					component("spriteName"):SetString("gfx/menu/map/map_banner_9s")
					component("layer"):SetString("HUD")
				]]>
			</event>
		</ninesliceComponent>

		<touchComponent name="Blocker">
			<size w="640*game.mapScale()" h="240*game.mapScale()" />
			<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="RIGHT" />
			<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="-10*game.mapScale()" yOffset="-20*game.mapScale()" priorityOffset="0" />
		</touchComponent>

		<!-- alert buttons -->

		<template type="template_spritesheetbutton" name="NotificationAlertButton">
			<script src="scripts/MapButton.lua"/>
			<templateVar name="$upSpriteName" equals="button_rnd_base" />
			<templateVar name="$sheetName" equals="'xml_resources/store_buttons01.xml'" />
			<templateVar name="$spriteScale" equals="0.6*game.mapScale()" />
			<templateVar name="$layer" equals="HUD" />
			<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="BOTTOM" hAnchor="LEFT" xOffset="0" yOffset="12*game.mapScale()" priorityOffset="-1" />
			<spriteSheetComponent name="Overlay">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			</spriteSheetComponent>
			<touchComponent name="Touch"/>
		</template>

		<template type="template_spritesheetbutton" name="SaleAlertButton">
			<script src="scripts/MapButton.lua"/>
			<templateVar name="$upSpriteName" equals="button_rnd_base" />
			<templateVar name="$sheetName" equals="'xml_resources/store_buttons01.xml'" />
			<templateVar name="$spriteScale" equals="0.6*game.mapScale()" />
			<templateVar name="$layer" equals="HUD" />
			<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="BOTTOM" hAnchor="LEFT" xOffset="0" yOffset="12*game.mapScale()" priorityOffset="-1" />
			<spriteSheetComponent name="Overlay">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
			</spriteSheetComponent>
			<touchComponent name="Touch"/>
		</template>

		<template type="template_spritesheetbutton" name="SeasonalAlertButton">
			<script src="scripts/MapButton.lua"/>
			<templateVar name="$upSpriteName" equals="button_rnd_base" />
			<templateVar name="$sheetName" equals="'xml_resources/store_buttons01.xml'" />
			<templateVar name="$spriteScale" equals="0.6*game.mapScale()" />
			<templateVar name="$layer" equals="HUD" />
			<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="BOTTOM" hAnchor="LEFT" xOffset="0" yOffset="12*game.mapScale()" priorityOffset="-1" />
			<spriteSheetComponent name="Overlay">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />					
			</spriteSheetComponent>			
			<touchComponent name="Touch"/>
		</template>

	</element>

	<element name="BottomHUD">
		<size w="(420-24)*game.mapScale()" h="(62 + lua_sys.deviceMarginY() + 12.5) * game.hudScale()"/>
		<position relativeTo="SCREEN" vAnchor="BOTTOM" hAnchor="LEFT" />
		<orientation vAnchor="BOTTOM" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="20"/>

		<template type="template_spritesheetbutton" name="OptionsButton">
			<script src="scripts/MapButton.lua"/>
			<templateVar name="$layer" equals="PopUps" />
			<templateVar name="$spriteScale" equals="0.5*game.hudScale()" />
			<position relativeTo="PARENT" vAnchor="TOP" hAnchor="RIGHT" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="8*game.hudScale()" yOffset="0" priorityOffset="0" />
			<touchComponent name="Touch"/>
				
			<spriteSheetComponent name="Overlay">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />				
			</spriteSheetComponent>
			<!-- text layout should match template_barbutton/ButtonLabel-->
			<textComponent name="Text">
				<size w="60*game.hudScale()" />
				<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
			</textComponent>				
		</template>

		<!-- "Simulated" ContextBar Button-->
		<!-- offset should balance out with help button, otherwise it ruins the go button's feng shui -->
		<template type="template_spritesheetbutton" name="MirrorButton">
			<script src="scripts/MapButton.lua"/>

			<templateVar name="$layer" equals="PopUps" />
			<templateVar name="$spriteScale" equals="0.5*game.hudScale()" />
			<position relativeTo="OptionsButton" vAnchor="TOP" hAnchor="RIGHT" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="4 * game.hudScale()" yOffset="0" priorityOffset="0" />
			<touchComponent name="Touch"/>
				
			<spriteSheetComponent name="Overlay">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />				
			</spriteSheetComponent>
			<!-- text layout should match template_barbutton/ButtonLabel-->
			<textComponent name="Text">
				<size w="60*game.hudScale()" />
				<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
			</textComponent>				

			<!-- sale indicator -->
			 <template type="template_saleindicator" name="SaleIndicator">
			 	<templateVar name="$layer" equals="PopUps" />
				<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
			 </template>
		</template>

	</element>


	<!-- Main Content needs to be offset by the size of the IslandList -->
	<element name="Main">

		<size w="lua_sys.screenWidth() - (420*game.mapScale())" h="lua_sys.screenHeight()-lua_sys.deviceMarginY()" />
		<position relativeTo="SAFE_AREA" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="0" yOffset="0" priorityOffset="20" />

		<!-- Island Name Banner -->
		<element name="IslandName"> 

			<size w="252*game.mapScale()" h="94 * game.mapScale()" />
			<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="24*game.mapScale()" priorityOffset="1" />

			<ninesliceComponent name="Sprite">
				<size dependentOnElement="element:name()"/>
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onInit" params="component, element">
					<![CDATA[
						component("topHeight"):SetFloat(0.0)
						component("bottomHeight"):SetFloat(0.0)
						component("leftWidth"):SetFloat(160.0)
						component("rightWidth"):SetFloat(160.0)
						component("size"):SetFloat(0.75*game.mapScale())
						component("includeBorder"):SetInt(1)
						component("spriteName"):SetString("gfx/menu/map/map_title_banner")
						component("layer"):SetString("PopUps")
						--component("alpha"):SetFloat(0)
					]]>
				</event>
			</ninesliceComponent>

			<textComponent name="Text">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-4*game.mapScale()" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					<![CDATA[
						component("multiline"):SetInt(0)
						component("font"):Set(game.getTextFont())
						component("size"):SetFloat(0.75*game.mapScale())
						component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
						component("autoScale"):SetInt(1)
						component("autoScaleFactor"):SetFloat(0.01)
						component("layer"):SetString("PopUps")
						--component("text"):SetString("You are Here")
					]]>
				</event>
			</textComponent>

		</element>

		<template type="template_spritesheetbutton" name="LeftButton">
			<templateVar name="$upSpriteName" equals="'map_title_banner_arrow'" />
			<templateVar name="$spriteScale" equals="0.75*game.mapScale()" />
			<templateVar name="$sheetName" equals="'xml_resources/map_icons_sheet.xml'" />
			<templateVar name="$layer" equals="PopUps" />
			<templateVar name="$alpha" equals="0" />
			<templateVar name="$spriteHFlip" equals="1" />
			<position relativeTo="IslandName" vAnchor="VCENTER" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="8*game.mapScale()" yOffset="0" priorityOffset="0" />
			<touchComponent name="Touch">
				<event name="onInit" params="component, element">
					<![CDATA[
						onInit(component, element)
						component("enabled"):SetInt(0)
					]]>
				</event>
				<event name="onTouchDown" params="component, element">
					<![CDATA[
						onTouchDown(component, element)
						element["Text"]:setColor(0.5, 0.5, 0.5)
					]]>
				</event>

				<event name="onTouchUp" params="component, element">
					<![CDATA[
						onTouchUp(component, element)
						element["Text"]:setColor(1.0, 1.0, 1.0)
						element:parent():parent():PreviousIsland()
					]]>
				</event>

				<event name="onTouchRelease" params="component, element">
					<![CDATA[
						onTouchRelease(component, element)
						element["Text"]:setColor(1.0, 1.0, 1.0)
					]]>
				</event>
			</touchComponent>
		</template>

		<template type="template_spritesheetbutton" name="RightButton">
			<templateVar name="$upSpriteName" equals="'map_title_banner_arrow'" />
			<templateVar name="$spriteScale" equals="0.75*game.mapScale()" />
			<templateVar name="$sheetName" equals="'xml_resources/map_icons_sheet.xml'" />
			<templateVar name="$layer" equals="PopUps" />	
			<templateVar name="$alpha" equals="0" />
			<position relativeTo="IslandName" vAnchor="VCENTER" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="8*game.mapScale()" yOffset="0" priorityOffset="1" />
			<touchComponent name="Touch">
				<event name="onInit" params="component, element">
					<![CDATA[
						onInit(component, element)
						component("enabled"):SetInt(0)
					]]>
				</event>
				<event name="onTouchDown" params="component, element">
					<![CDATA[
						onTouchDown(component, element)
						element["Text"]:setColor(0.5, 0.5, 0.5)
					]]>
				</event>

				<event name="onTouchUp" params="component, element">
					<![CDATA[
						onTouchUp(component, element)
						element["Text"]:setColor(1.0, 1.0, 1.0)
						element:parent():parent():NextIsland()
					]]>
				</event>

				<event name="onTouchRelease" params="component, element">
					<![CDATA[
						onTouchRelease(component, element)
						element["Text"]:setColor(1.0, 1.0, 1.0)
					]]>
				</event>
			</touchComponent>
		</template>

		<element name="IslandInfo">
			<size w="lua_sys.screenWidth() - (420*game.mapScale())" h="240*game.mapScale()" />
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="70*game.mapScale()" priorityOffset="-1" />

			<element name="BedsOccupied">
				<size dependentOnElement="element:name()" dependentOnComponent="Text"/>
				<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
				<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<textComponent name="Text">
					<event name="onInit" params="component, element">
						<![CDATA[ 
							component("multiline"):SetInt(0)
							component("font"):Set(game.getTextFont())
							component("size"):SetFloat(0.45*game.mapScale())
							component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
							component("text"):SetString("Beds Occupied: 0/99")
							component("autoScaleFactor"):SetFloat(0.01)
							component("autoScale"):SetInt(1)
							component("layer"):SetString("PopUps")
						]]>
					</event>
				</textComponent>
			</element>

			<element name="Collected">
				<size w="lua_sys.screenWidth() - (420*game.mapScale())" h="39*game.mapScale()" />
				<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
				<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="36*game.mapScale()" priorityOffset="-1" />

				<template type="template_map_info_item" name="CollectedCommons">
					<templateVar name="$spriteName" equals="'map_common_icon'" />
					<templateVar name="$toolTip" equals="COMMONS_LABEL"></templateVar>
					<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
					<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
					<event name="onPostInit" params="element">
						onPostInit(element)
						element:Hide()
					</event>
				</template>

				<template type="template_map_info_item" name="CollectedRares">
					<templateVar name="$spriteName" equals="'map_rare_icon'" />
					<templateVar name="$toolTip" equals="RARES_LABEL"></templateVar>
					<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
					<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
					<event name="onPostInit" params="element">
						onPostInit(element)
						element:Hide()
					</event>
				</template>

				<template type="template_map_info_item" name="CollectedEpics">
					<templateVar name="$spriteName" equals="'map_epic_icon'" />
					<templateVar name="$toolTip" equals="EPICS_LABEL"></templateVar>
					<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
					<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
					<event name="onPostInit" params="element">
						onPostInit(element)
						element:Hide()
					</event>
				</template>

				<template type="template_map_info_item" name="CollectedSeasonals">
					<templateVar name="$spriteName" equals="'map_seasonal_icon'" />
					<templateVar name="$toolTip" equals="SEASONALS_LABEL"></templateVar>
					<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
					<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
					<event name="onPostInit" params="element">
						onPostInit(element)
						element:Hide()
					</event>
				</template>

				<template type="template_map_info_item" name="CollectedCostumes">
					<templateVar name="$spriteName" equals="'map_costume_icon'" />
					<templateVar name="$toolTip" equals="COSTUMES_TITLE"></templateVar>
					<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
					<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="0" />
					<event name="onPostInit" params="element">
						onPostInit(element)
						element:Hide()
					</event>
				</template>	
			</element>

			<!-- Dummy node that runs after all the onPostInits of the Collected hierarchy -->
			<element name="CollectedLayoutHelper">
				<event name="onPostInit" params="element">
					<![CDATA[ 
						element:Refresh()
					]]>
				</event>
				<event name="Refresh" params="element">
					<![CDATA[ 
						local MenuHelpers = include("MenuHelpers")
						local t = element:parent().Collected
						local spacer = MenuHelpers.CreateSpacer(12*game.mapScale())
						
						local items = {}
						local function insertIfVisible(item)
							if item.isVisible then
								table.insert(items, spacer)	
								table.insert(items, item)
							end
						end

						table.insert(items, t.CollectedCommons)
						insertIfVisible(t.CollectedRares)
						insertIfVisible(t.CollectedEpics)
						insertIfVisible(t.CollectedSeasonals)
						insertIfVisible(t.CollectedCostumes)

						MenuHelpers.CenterHorizontally(items)
					]]>
				</event>
			</element>

			<!-- Cost -->
			<element name="CostInfo">
				<size w="lua_sys.screenWidth() - (420*game.mapScale())" h="20*game.mapScale()" />
				<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
				<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />

				<!-- if there is a sale, this shows the regular price crossed out with a red stripe-->
				<template type="template_map_info_item" name="SaleInfo">
					<templateVar name="$spriteName" equals="game.StoreContext_SPRITE_COINS" />
					<templateVar name="$sheetName" equals="game.StoreContext_CURRENCY_SPRITESHEET" />
					<templateVar name="$scale" equals="1.33" />
					<templateVar name="$spriteScale" equals="0.66" />
					<templateVar name="$height" equals="20*game.mapScale()" />
					<templateVar name="$toolTipEnabled" equals="0" />
					<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
					<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />	

					<!-- add a red stripe -->
					<ninesliceComponent name="RedStrip">
						<size w="4" h="4" />
						<position relativeTo="element:name()" component="Text" vAnchor="VCENTER" hAnchor="HCENTER" />
						<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
						<event name="onInit" params="component, element">
							component("includeBorder"):SetInt(1)
							component("topHeight"):SetFloat(1.0)
							component("bottomHeight"):SetFloat(1.0)
							component("leftWidth"):SetFloat(1.0)
							component("rightWidth"):SetFloat(1.0)
							component("alpha"):SetFloat(0.6)
							component("spriteName"):SetString("gfx/menu/redstrip")
							component("layer"):SetString("MidPopUps")
							component("visible"):SetInt(0)
						</event>

					</ninesliceComponent>

					<event name="onPostInit" params="element">
						onPostInit(element)
						element:Hide()
					</event>
					
					<event name="Refresh" params="element">
						Refresh(element)
