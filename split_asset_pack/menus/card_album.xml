<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">
	<script src="scripts/CardAlbum.lua"/>
	
	<element name="bg">
		<size dependentOnElement="element:name()" dependentOnComponent="TouchCatcher" />
		<position relativeTo="SCREEN" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="0" priorityOffset="20" />
		<touchComponent name="TouchCatcher">
			<size w="lua_sys.screenWidth()" h="lua_sys.screenHeight()" />
			<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="20" />
		</touchComponent>
	</element>

	<element name="BGGradient">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="49" />
		<spriteComponent name="Sprite"/>
	</element>

	<element name="BGPattern">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="48" />
		<spriteComponent name="Sprite"/>
	</element>

	<element name="AlbumPanel">
		<size w="140*game.windowScaleY()" h="300*game.windowScaleY()" />
		<position relativeTo="bg" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="lua_sys.screenWidth() * 1.0" yOffset="0" priorityOffset="-2" />

		<element name="TitleFrame">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="PARENT" vAnchor="TOP" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="5*game.windowScaleY()" priorityOffset="-1" />
			<ninesliceComponent name="Sprite">
				<size w="130*game.windowScaleY()" h="30*game.windowScaleY()" />
				<event name="onInit" params="component, element">
					component("topHeight"):SetFloat(50.0)
					component("bottomHeight"):SetFloat(50.0)
					component("leftWidth"):SetFloat(50.0)
					component("rightWidth"):SetFloat(50.0)
					component("size"):SetFloat(0.4*game.windowScaleY())
					component("includeBorder"):SetInt(1)
					component("spriteName"):SetString("gfx/menu/GreyTitleFrame")
					component("layer"):SetString("MidPopUps")
				</event>
			</ninesliceComponent>
		</element>

		<element name="TitleText">
			<size dependentOnElement="element:name()" dependentOnComponent="Text" />
			<position relativeTo="TitleFrame" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="5*game.windowScaleY()" priorityOffset="-1" />
			<textComponent name="Text">
				<size w="95*game.windowScaleY()" h="30*game.windowScaleY()"/>
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onInit" params="component, element">
					component("multiline"):SetInt(0)
					component("font"):Set(game.getTitleFont())
					local palette = include("ColourPalette")
					component:setColor(palette:getRGBFloats(palette.TITLE_YELLOW))
					component("size"):SetFloat(0.20*game.windowScaleY())
					component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
					component("text"):SetString(game.localizedUpper(""))
					component("autoScaleFactor"):SetFloat(0.01)
					component("autoScale"):SetInt(1)
					component("layer"):SetString("MidPopUps")
				</event>
			</textComponent>
		</element>

		<element name="Prestige">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="TitleFrame" vAnchor="VCENTER" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="-7*game.windowScaleY()" yOffset="3*game.windowScaleY()" priorityOffset="-1" />
			<spriteSheetComponent name="Sprite">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onInit" params="component, element">
					component("spriteName"):SetString("prestige_counter")
					local cardAlbumEvent = game.getCurrentCardAlbumEvent()
					local cardAlbum = game.getCardAlbumData(cardAlbumEvent:getCardAlbumId())
					component("sheetName"):SetString("xml_resources/" .. cardAlbum.assetPath)
					component("size"):SetFloat(0.35*game.windowScaleY())
					component("layer"):SetString("MidPopUps")
					component("visible"):SetInt(0)
				</event>
			</spriteSheetComponent>
			<textComponent name="Text">
				<size dependentOnElement="element:name()" />
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("multiline"):SetInt(0)
					component("font"):Set(game.getTitleFont())
					component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
					component("size"):SetFloat(0.13*game.windowScaleY())
					component("text"):SetString("1")
					component("autoScaleFactor"):SetFloat(0.01)
					component("autoScale"):SetInt(1)
					component("layer"):SetString("MidPopUps")
					component("visible"):SetInt(0)
				</event>
			</textComponent>
		</element>

		<element name="Timer">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="TitleFrame" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0*game.windowScaleY()" priorityOffset="-1" />
			<spriteComponent name="Sprite">
					<event name="onInit" params="component, element">
						<![CDATA[
							component("spriteName"):SetString("gfx/menu/wooden_plank")
							component("visible"):SetInt(1)
							component:setScale(Vector2(0.16*game.windowScaleY(), 0.20*game.windowScaleY()))
							component("layer"):SetString("MidPopUps")
						]]>
					</event>
			</spriteComponent>		
			<textComponent name="Text">
				<size w="60*game.windowScaleY()" h="30*game.windowScaleY()" />
				<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-2*game.windowScaleY()" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("multiline"):SetInt(0)
					component("font"):Set(game.getTextFont())
					component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
					component("size"):SetFloat(0.18*game.windowScaleY())
					component("text"):SetString("0")
					component("autoScaleFactor"):SetFloat(0.01)
					component("autoScale"):SetInt(1)
					component("layer"):SetString("MidPopUps")
				</event>
			</textComponent>
		</element>

		<element name="Banner">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="TitleFrame" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="1" />
			<spriteSheetComponent name="Sprite">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onInit" params="component, element">
					component("spriteName"):SetString("album_banner_01")
					local cardAlbumEvent = game.getCurrentCardAlbumEvent()
					local cardAlbum = game.getCardAlbumData(cardAlbumEvent:getCardAlbumId())
					component("sheetName"):SetString("xml_resources/" .. cardAlbum.assetPath)
					component("size"):SetFloat(0.35*game.windowScaleY())
					component("layer"):SetString("MidPopUps")
				</event>
			</spriteSheetComponent>
		</element>

		<element name="RewardFrame">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="Banner" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-30*game.windowScaleY()" priorityOffset="2" />
			<ninesliceComponent name="Sprite">
				<size w="130*game.windowScaleY()" h="115*game.windowScaleY()" />
				<event name="onInit" params="component, element">
					component("topHeight"):SetFloat(50.0)
					component("bottomHeight"):SetFloat(50.0)
					component("leftWidth"):SetFloat(50.0)
					component("rightWidth"):SetFloat(50.0)
					component("size"):SetFloat(0.4*game.windowScaleY())
					component("includeBorder"):SetInt(1)
					component("spriteName"):SetString("gfx/menu/Black9SFrame50")
					component("layer"):SetString("MidPopUps")
				</event>
			</ninesliceComponent>
			<textComponent name="Text">
				<size w="95*game.windowScaleY()" h="30*game.windowScaleY()" />
				<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="HCENTER" />
				<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="10*game.windowScaleY()" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("multiline"):SetInt(0)
					component("font"):Set(game.getTitleFont())
					local palette = include("ColourPalette")
					component:setColor(palette:getRGBFloats(palette.TITLE_YELLOW))
					component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
					component("size"):SetFloat(0.18*game.windowScaleY())
					component("text"):SetString("CARD_ALBUM_TOP_PRIZES")
					component("autoScaleFactor"):SetFloat(0.01)
					component("autoScale"):SetInt(1)
					component("layer"):SetString("MidPopUps")
				</event>
			</textComponent>
			<element name="RewardList">
				<size w="120*game.windowScaleY()" h="70*game.windowScaleY()" />
				<position relativeTo="PARENT" component="Text" vAnchor="TOP" hAnchor="HCENTER" />
				<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<template type="template_card_album_reward" name="Reward1">
					<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="HCENTER" />
					<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="0" yOffset="0*game.windowScaleY()" priorityOffset="0" />
				</template>
				<template type="template_card_album_reward" name="Reward2">
					<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="HCENTER" />
					<orientation vAnchor="BOTTOM" hAnchor="LEFT" xOffset="0" yOffset="0*game.windowScaleY()" priorityOffset="0" />
				</template>
			</element>
		</element>

		<element name="Bar">
			<size w="130*game.windowScaleY()" h="30*game.windowScaleY()" />
			<position relativeTo="RewardFrame" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0*game.windowScaleY()" yOffset="0*game.windowScaleY()" priorityOffset="0" />
				<spriteSheetComponent name="BarBackingSprite">
					<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
					<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
					<event name="onInit" params="component, element">
						component("spriteName"):SetString("level_bar_empty")
						component("sheetName"):SetString("xml_resources/hud01.xml")
						component("layer"):SetString("MidPopUps")
						component("size"):SetFloat(0.35*game.windowScaleY())
						component:setPositionBroadcast(true)
					</event>
				</spriteSheetComponent>
		
				<spriteSheetComponent name="BarSprite">
					<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
					<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-1*game.windowScaleY()" priorityOffset="-1" />
					<event name="onInit" params="component, element">
						component("spriteName"):SetString("album_progress_bar")
						component("sheetName"):SetString("xml_resources/hud01.xml")
						component("size"):SetFloat(0.35*game.windowScaleY())
						component("layer"):SetString("MidPopUps")
						component("FullMaskH"):SetInt(component("maskHeight"):GetInt())
						component("FullMaskW"):SetInt(component("maskWidth"):GetInt())
					</event>
				</spriteSheetComponent>

				<spriteSheetComponent name="BarIcon">
					<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="LEFT" />
					<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="-5*game.windowScaleY()" yOffset="0" priorityOffset="-2" />
					<event name="onInit" params="component, element">
						component("spriteName"):SetString("stickers_icon")
						component("sheetName"):SetString("xml_resources/hud01.xml")
						component("size"):SetFloat(0.35*game.windowScaleY())
						component("layer"):SetString("MidPopUps")
						component("FullMaskH"):SetInt(component("maskHeight"):GetInt())
						component("FullMaskW"):SetInt(component("maskWidth"):GetInt())
					</event>
				</spriteSheetComponent>
		
				<textComponent name="BarText">
					<size w="50*game.windowScaleY()" h="30*game.windowScaleY()" />
					<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
					<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
					<event name="onInit" params="component, element">
						component("textPadding"):SetInt(8)
						component("multiline"):SetInt(0)
						component("font"):Set(game.getTextFont())
						component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
						component("size"):SetFloat(0.18*game.windowScaleY())
						component("text"):SetString("0")
						component("autoScaleFactor"):SetFloat(0.01)
						component("autoScale"):SetInt(1)
						component("layer"):SetString("MidPopUps")
					</event>
				</textComponent>

				<template type="template_nineslicebutton" name="CollectButton">
					<templateVar name="$upSpriteName" equals="'gfx/menu/button_green_gem'" />
					<templateVar name="$spriteScale" equals="0.3*game.windowScaleY()" />
					<templateVar name="$text" equals="LABEL_COLLECT" />
					<templateVar name="$font" equals="'game.getTitleFont()'" />
					<templateVar name="$textPadding" equals="4*game.windowScaleY()" />
					<templateVar name="$autoScaleFactor" equals="0.01" />
					<templateVar name="$topHeight" equals="30.0" />
					<templateVar name="$bottomHeight" equals="30.0" />
					<templateVar name="$leftWidth" equals="35.0" />
					<templateVar name="$rightWidth" equals="35.0" />
					<templateVar name="$width" equals="100*game.windowScaleY()" />
					<templateVar name="$height" equals="30*game.windowScaleY()" />
					<templateVar name="$includeBorder" equals="1" />	
					<templateVar name="$layer" equals="MidPopUps" />
					<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
					<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-1*game.windowScaleY()" priorityOffset="-1" />
		
					<textComponent name="Text">
						<event name="onInit" params="component, element">
							onInit(component, element)
							component("size"):SetFloat(0.18*game.windowScaleY())
						</event>
					</textComponent>
					<touchComponent name="Touch">
						<event name="onTouchUp" params="component, element">
							onTouchUp(component, element)
							element:parent():parent():parent():collectAlbumReward()
						</event>
					</touchComponent>
				</template>

				<textComponent name="CollectedText">
					<size w="120*game.windowScaleY()" h="30*game.windowScaleY()" />
					<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
					<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-2" />
					<event name="onInit" params="component, element">
						component("textPadding"):SetInt(8)
						component("multiline"):SetInt(0)
						component("font"):Set(game.getTextFont())
						component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
						component("size"):SetFloat(0.4*game.windowScaleY())
						component("text"):SetString("CARD_ALBUM_REWARD_COLLECTED")
						component("autoScaleFactor"):SetFloat(0.01)
						component("autoScale"):SetInt(1)
						component("layer"):SetString("MidPopUps")
					</event>
				</textComponent>

				<spriteSheetComponent name="Notification">
					<position relativeTo="CollectButton" vAnchor="TOP" hAnchor="RIGHT" />
					<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="0" yOffset="0" priorityOffset="0" />
					<event name="onInit" params="component, element">
						component("spriteName"):SetString("new_sticker")
						local cardAlbumEvent = game.getCurrentCardAlbumEvent()
						local cardAlbum = game.getCardAlbumData(cardAlbumEvent:getCardAlbumId())
						component("sheetName"):SetString("xml_resources/" .. cardAlbum.assetPath)
						component("size"):SetFloat(0.2*game.windowScaleY())
						component("layer"):SetString("MidPopUps")
					</event>
				</spriteSheetComponent>
		</element>

		<template type="template_spritesheetbutton" name="InfoButton">
			<templateVar name="$layer" equals="MidPopUps" />
			<templateVar name="$spriteScale" equals="0.5*game.hudScale()" />
			<position relativeTo="Bar" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="5*game.hudScale()" yOffset="0*game.windowScaleY()" priorityOffset="-1" />
			<touchComponent name="Touch">
				<event name="onTouchDown" params="component, element">
					onTouchDown(component, element)
					element["Text"]:setColor(1.0, 1.0, 1.0)
					element["Overlay"]:setColor(0.5, 0.5, 0.5)
				</event>
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					element["Overlay"]:setColor(1.0, 1.0, 1.0)
					element:parent():parent():showInfo()
				</event>
				<event name="onTouchRelease" params="component, element">
					onTouchRelease(component, element)
					element["Overlay"]:setColor(1.0, 1.0, 1.0)
				</event>
			</touchComponent>
			<spriteSheetComponent name="Overlay">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("spriteName"):SetString("button_info2")
					component("sheetName"):SetString("xml_resources/context_buttons.xml")
					component("size"):SetFloat(0.5*game.hudScale())
					component("layer"):SetString("MidPopUps")
				</event>
			</spriteSheetComponent>
			<textComponent name="Text">
				<size w="64*game.hudScale()" />
				<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onInit" params="component, element">
					component("multiline"):SetInt(0)
					component("font"):Set(game.getTitleFont())
					component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
					component("size"):SetFloat(0.25*game.hudScale())
					component("text"):SetString("CONTEXTBAR_INFO_LABEL")
					component("autoScaleFactor"):SetFloat(0.01)
					component("autoScale"):SetInt(1)
					component("layer"):SetString("MidPopUps")
				</event>
			</textComponent>
			<event name="onTick" params="element, dt">
				onTick(element, dt)
				if(element["UpSprite"]("size"):GetFloat() ~= element["Overlay"]("size"):GetFloat()) then
					element["Overlay"]("size"):SetFloat(element["UpSprite"]("size"):GetFloat())
				end
			</event>
			<event name="Hide" params="element">
				element:DoStoredScript("setInvisible")
				element["Overlay"]("visible"):SetInt(0)
				element["Text"]("visible"):SetInt(0)
				element["Touch"]("enabled"):SetInt(0)
			</event>
			<event name="Show" params="element">
				element:DoStoredScript("setVisible")
				element["Overlay"]("visible"):SetInt(1)
				element["Text"]("visible"):SetInt(1)
				element["Touch"]("enabled"):SetInt(1)
			</event>
		</template>
	
		<template type="template_spritesheetbutton" name="StoreButton">
			<templateVar name="$layer" equals="MidPopUps" />
			<templateVar name="$spriteScale" equals="0.5*game.hudScale()" />
			<position relativeTo="Bar" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="5*game.hudScale()" yOffset="0*game.windowScaleY()" priorityOffset="-1" />
			<touchComponent name="Touch">
				<event name="onTouchDown" params="component, element">
					onTouchDown(component, element)
					element["Text"]:setColor(1.0, 1.0, 1.0)
					element["Overlay"]:setColor(0.5, 0.5, 0.5)
