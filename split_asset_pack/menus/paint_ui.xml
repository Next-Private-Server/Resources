<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">

	<script src="scripts/PaintUI.lua" />

	<!-- TOP -->
	<element name="CoinCounter">
		<size dependentOnElement="element:name()" dependentOnComponent="BackingSprite" />
		<position relativeTo="DiamondCounter" vAnchor="TOP" hAnchor="LEFT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="3*game.menuScaleX()" yOffset="0" priorityOffset="1" />
		<ninesliceComponent name="BackingSprite">
			<size w="100*game.menuScaleX()" h="31*game.hudScale()" />
			<event name="onInit" params="component, element">
				component("includeBorder"):SetInt(1)
				component("topHeight"):SetFloat(30.0)
				component("bottomHeight"):SetFloat(30.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("size"):SetFloat(0.25*game.menuScaleX())
				component("spriteName"):SetString("gfx/menu/BlackTitleFrame")
				component("layer"):SetString("HUD")
			</event>
		</ninesliceComponent>
		<spriteSheetComponent name="Icon">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="0" yOffset="2*game.hudScale()" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString(game.coinsSpriteImgForThisIsland())
				component("sheetName"):SetString(game.StoreContext_CURRENCY_SPRITESHEET)
				component("size"):SetFloat(0.5*game.hudScale())
				component("layer"):SetString("HUD")
			</event>
		</spriteSheetComponent>
		<textComponent name="Text">
			<size w="65*game.menuScaleX()" h="100" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="10*game.hudScale()" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTextFont())
				component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("size"):SetFloat(0.25*game.menuScaleX())
				if(game.isEtherealIsland()) then
					component("text"):SetString(game.commaizeNumber(game.playerEtherealCurrency()))
					game.StoreContext_setCurrencyTypeColour(game.CurrencyType_Shards, component)
				else
					component("text"):SetString(game.commaizeNumber(game.playerCoins()))
					game.StoreContext_setCurrencyTypeColour(game.CurrencyType_Coins, component)
				end
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				component("layer"):SetString("HUD")
			</event>
		</textComponent>
		
		<event name="updateText" params="element">
			element["Text"]:SetString(game.commaizeNumber(game.playerCoins()))
		</event>

		<event name="onInit" params="element">
			element("currencyType"):SetString(game.StoreContext_TYPE_COINS);
		</event>

		<event name="setAsCoins" params="element">
			element("currencyType"):SetString(game.StoreContext_TYPE_COINS);
			element["Text"]:DoStoredScript("setAsCoins")
		</event>
		<event name="setAsEthereal" params="element">
			element("currencyType"):SetString(game.StoreContext_TYPE_ETH_CURRENCY);
			element["Text"]:DoStoredScript("setAsEthereal")
		</event>

		<event name="hide" params="element">
			element["BackingSprite"]("visible"):SetInt(0)
			element["Icon"]("visible"):SetInt(0)
			element["Plus"]("visible"):SetInt(0)
			element["Text"]("visible"):SetInt(0)
			element["Touch"]("enabled"):SetInt(0)
		</event>
		<event name="show" params="element">
			element["BackingSprite"]("visible"):SetInt(1)
			element["Icon"]("visible"):SetInt(1)
			element["Plus"]("visible"):SetInt(1)
			element["Text"]("visible"):SetInt(1)
			element["Touch"]("enabled"):SetInt(1)
		</event>
	</element>
	<element name="CoinWood">
		<size dependentOnElement="element:name()" dependentOnComponent="bg" />
		<position relativeTo="CoinCounter" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-6*game.menuScaleY()" priorityOffset="5" />
		<spriteSheetComponent name="bg">
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_battle_attack")
				component("sheetName"):SetString("xml_resources/element_buttons.xml")		
				component("size"):SetFloat(0.3*game.menuScaleX())
				component("layer"):SetString("HUD")
				component("vFlip"):SetInt(1)
			</event>
		</spriteSheetComponent>
		<textComponent name="Text">
			<size w="65*game.menuScaleX()" h="100" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="10*game.hudScale()" yOffset="2*game.menuScaleY()" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTextFont())
				component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("size"):SetFloat(0.25*game.menuScaleX())
				component("text"):SetString("0")
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				component("layer"):SetString("HUD")
			</event>
		</textComponent>
	</element>

	<element name="DiamondCounter">
		<size dependentOnElement="element:name()" dependentOnComponent="BackingSprite" />
		<position relativeTo="SAFE_AREA" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="0" yOffset="0" priorityOffset="29" />
		<ninesliceComponent name="BackingSprite">
			<size w="100*game.menuScaleX()" h="31*game.hudScale()" />
			<event name="onInit" params="component, element">
				component("includeBorder"):SetInt(1)
				component("topHeight"):SetFloat(30.0)
				component("bottomHeight"):SetFloat(30.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("size"):SetFloat(0.25*game.menuScaleX())
				component("spriteName"):SetString("gfx/menu/BlackTitleFrame")
				component("layer"):SetString("HUD")
			</event>
		</ninesliceComponent>
		<spriteSheetComponent name="Icon">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="-4*game.hudScale()" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("spriteName"):SetString(game.StoreContext_SPRITE_DIAMOND)
				component("sheetName"):SetString(game.StoreContext_CURRENCY_SPRITESHEET)
				component("size"):SetFloat(0.5*game.hudScale())
				component("layer"):SetString("HUD")
			</event>
		</spriteSheetComponent>
		<textComponent name="Text">
			<size w="65*game.menuScaleX()" h="100" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="10*game.hudScale()" yOffset="0" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTextFont())
				component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("size"):SetFloat(0.25*game.menuScaleX())
				component("text"):SetString(game.commaizeNumber(game.playerDiamonds()))
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				game.StoreContext_setCurrencyTypeColour(game.CurrencyType_Diamonds, component)
				component("layer"):SetString("HUD")
			</event>
		</textComponent>
		<event name="updateText" params="element">
			element["Text"]:SetString(game.commaizeNumber(game.playerDiamonds()))
		</event>
		<event name="hide" params="element">
			element["BackingSprite"]("visible"):SetInt(0)
			element["Icon"]("visible"):SetInt(0)
			element["Plus"]("visible"):SetInt(0)
			element["Text"]("visible"):SetInt(0)
			element["Touch"]("enabled"):SetInt(0)
		</event>
		<event name="show" params="element">
			element["BackingSprite"]("visible"):SetInt(1)
			element["Icon"]("visible"):SetInt(1)
			element["Plus"]("visible"):SetInt(1)
			element["Text"]("visible"):SetInt(1)
			element["Touch"]("enabled"):SetInt(1)
		</event>
	</element>
	<element name="DiamondWood">
		<size dependentOnElement="element:name()" dependentOnComponent="bg" />
		<position relativeTo="DiamondCounter" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-6*game.menuScaleY()" priorityOffset="5" />
		<spriteSheetComponent name="bg">
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("button_battle_attack")
				component("sheetName"):SetString("xml_resources/element_buttons.xml")		
				component("size"):SetFloat(0.3*game.menuScaleX())
				component("layer"):SetString("HUD")
				component("vFlip"):SetInt(1)
			</event>
		</spriteSheetComponent>
		<textComponent name="Text">
			<size w="65*game.menuScaleX()" h="100" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="10*game.hudScale()" yOffset="2*game.menuScaleY()" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTextFont())
				component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("size"):SetFloat(0.25*game.menuScaleX())
				component("text"):SetString("0")
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				component("layer"):SetString("HUD")
			</event>
		</textComponent>
	</element>


	<!-- LEFT -->
 	<element name="Panel"> 
		<size dependentOnElement="element:name()" dependentOnComponent="bg" />
		<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="-150*game.menuScaleY() + lua_sys.deviceMarginX()" yOffset="-26*game.menuScaleY()" priorityOffset="5" />

		<ninesliceComponent name="bg">
			<size w="300*game.menuScaleY()" h="260*game.menuScaleY()" />
			<event name="onInit" params="component, element">
				component("includeBorder"):SetInt(1)
				component("topHeight"):SetFloat(50.0)
				component("bottomHeight"):SetFloat(50.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("size"):SetFloat(0.4*game.menuScaleY())
				component("spriteName"):SetString("gfx/menu/Black9SFrame50")
				component("layer"):SetString("HUD")
			</event>
		</ninesliceComponent>

        <touchComponent name="PanelBlock" >
            <size dependentOnElement="element:name()"/>
            <position relativeTo="PARENT"/>
            <orientation priorityOffset="-1" />
        </touchComponent>

		<element name="TabPathNative">
			<size dependentOnElement="element:name()" dependentOnComponent="bg" />
			<position relativeTo="PARENT" vAnchor="TOP" hAnchor="RIGHT" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="-27*game.menuScaleY()" yOffset="40*game.menuScaleY()" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component:parent():parent():selectMarketTab("TabPathNative")
			</event>
			<event name="selectTab" params="element">
				element:setOrientationPriority(-2)
			</event>
			<event name="deselectTab" params="element">
				element:setOrientationPriority(1)
			</event>
			<spriteComponent name="bg">
				<event name="onInit" params="component, element">
					component("spriteName"):SetString("gfx/menu/tab01")
					component("rotation"):SetFloat(90)
					component("layer"):SetString("HUD")
					component("size"):SetFloat(0.4*game.menuScaleY())
				</event>
			</spriteComponent>
			<spriteSheetComponent name="icon">
				<position relativeTo="element" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("spriteName"):SetString("button_path_common")
					component("sheetName"):SetString("xml_resources/buttons02.xml")
					component("layer"):SetString("HUD")
					component("size"):SetFloat(0.25*game.menuScaleY())
				</event>	
			</spriteSheetComponent>	
			<touchComponent name="Touch">
				<size w="28*game.menuScaleY()" h="40*game.menuScaleY()" />
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onTouchUp" params="component, element">
					element:parent():parent():selectMarketTab("TabPathNative")
				</event>
			</touchComponent>
		</element>

		<element name="TabPathFilters">
			<size dependentOnElement="element:name()" dependentOnComponent="bg" />
			<position relativeTo="PARENT" vAnchor="TOP" hAnchor="RIGHT" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="-27*game.menuScaleY()" yOffset="85*game.menuScaleY()" priorityOffset="-1" />
			<event name="selectTab" params="element">
				element:setOrientationPriority(-2)
			</event>
			<event name="deselectTab" params="element">
				element:setOrientationPriority(4)
			</event>
			<spriteComponent name="bg">
				<event name="onInit" params="component, element">
					component("spriteName"):SetString("gfx/menu/tab01")
					component("rotation"):SetFloat(90)
					component("layer"):SetString("HUD")
					component("size"):SetFloat(0.4*game.menuScaleY())
				</event>
			</spriteComponent>		
			<spriteSheetComponent name="icon">
				<position relativeTo="element" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("spriteName"):SetString("button_showhide")
					component("sheetName"):SetString("xml_resources/context_buttons.xml")
					component("layer"):SetString("HUD")
					component("size"):SetFloat(0.25*game.menuScaleY())
				</event>	
			</spriteSheetComponent>	
			<touchComponent name="Touch">
				<size w="28*game.menuScaleY()" h="40*game.menuScaleY()" />
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
				<event name="onTouchUp" params="component, element">
					element:parent():parent():selectMarketTab("TabPathFilters")
				</event>
			</touchComponent>
		</element>

		<element name="ShowHide">
			<size dependentOnElement="element:name()" dependentOnComponent="Arrow" />
			<position relativeTo="PARENT" vAnchor="TOP" hAnchor="RIGHT" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="224*game.menuScaleY()" priorityOffset="-1" />
			<touchComponent name="Touch">
				<size dependentOnElement="element:name()" />
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-5" />
				<event name="onTouchDown" params="component, element">
					element["Arrow"]:setColor(0.5, 0.5, 0.5)
				</event>
				<event name="onTouchUp" params="component, element">
					element["Arrow"]:setColor(1.0, 1.0, 1.0)
					element:parent():parent():toggleMarket()
				</event>
				<event name="onTouchRelease" params="component, element">
					element["Arrow"]:setColor(1.0, 1.0, 1.0)
				</event>
			</touchComponent>
			<spriteSheetComponent name="Arrow">
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="4" yOffset="0" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					<![CDATA[
						component.closeAngle = -123
						component.openAngle = 56
						component("spriteName"):SetString("arrow01")
						component("sheetName"):SetString("xml_resources/hud01.xml")
						component("size"):SetFloat(0.25*game.menuScaleY())
						component("layer"):SetString("HUD")
						component("rotation"):SetFloat(component.closeAngle*math.pi/180)
					]]>
				</event>
			</spriteSheetComponent>
		</element>


		<template type="template_spritesheetbutton" name="PreviousButton">
			<templateVar name="$layer" equals="HUD" />
			<templateVar name="$spriteScale" equals="0.2*game.menuScaleY()" />
			<position relativeTo="NextButton" vAnchor="VCENTER" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="28*game.menuScaleY()" yOffset="0" priorityOffset="0" />

			<spriteComponent name="Arrow">
				<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-2*game.menuScaleY()" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					<![CDATA[
					component("spriteName"):SetString("gfx/menu/button_small_play")
					component("hFlip"):SetInt(1)
					component("layer"):SetString("HUD")
					]]>
				</event>
				<event name="onTick" params="component, element, dt">
					<![CDATA[
					component("size"):SetFloat(element["UpSprite"]("size"):GetFloat() * 1.6)
					]]>
				</event>
			</spriteComponent>

			<event name="hide" params="element">
				element["Arrow"]("visible"):SetInt(0)
				element:DoStoredScript("setInvisible")
			</event>

			<event name="show" params="element">
				element["Arrow"]("visible"):SetInt(1)
				element:DoStoredScript("setVisible")
			</event>

			<touchComponent name="Touch">
            	<size dependentOnElement="element:name()"/>
				<position relativeTo="PARENT"/>
				<orientation priorityOffset="-5" />
				<event name="onTouchDown" params="component, element">
					onTouchDown(component, element)
					element["Arrow"]:setColor(0.5, 0.5, 0.5)
				</event>
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					element["Arrow"]:setColor(1.0, 1.0, 1.0)
					element:parent():parent():previousPage()
				</event>
				<event name="onTouchRelease" params="component, element">
					onTouchRelease(component, element)
					element["Arrow"]:setColor(1.0, 1.0, 1.0)
				</event>
			</touchComponent>
		</template>

		<textComponent name="PageLabel">
			<size w="16*game.menuScaleY()" />
			<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="HCENTER" />
			<orientation vAnchor="BOTTOM" hAnchor="HCENTER" xOffset="70*game.menuScaleY()" yOffset="26*game.menuScaleY()" priorityOffset="-3" />
			<event name="onInit" params="component, element">
				<![CDATA[
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTitleFont())
				component("alignment"):SetInt(MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("size"):SetFloat(0.25*game.menuScaleY())
				component("autoScaleFactor"):SetFloat(0.01)
				component("autoScale"):SetInt(1)
				component("layer"):SetString("HUD")
				component("text"):SetString("0/0")
				]]>
			</event>
			<event name="hide" params="element">
				element("visible"):SetInt(0)
			</event>

			<event name="show" params="element">
				element("visible"):SetInt(1)
			</event>
		</textComponent>

		<template type="template_spritesheetbutton" name="NextButton">
			<templateVar name="$layer" equals="HUD" />
			<templateVar name="$spriteScale" equals="0.2*game.menuScaleY()" />
			<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="RIGHT" />
			<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="44*game.menuScaleY()" yOffset="16*game.menuScaleY()" priorityOffset="-3" />

			<spriteComponent name="Arrow">
				<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-2*game.hudScale()" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					<![CDATA[
					component("spriteName"):SetString("gfx/menu/button_small_play")
					component("layer"):SetString("HUD")
					]]>
				</event>
				<event name="onTick" params="component, element, dt">
					<![CDATA[
					component("size"):SetFloat(element["UpSprite"]("size"):GetFloat() * 1.6)
					]]>
				</event>
			</spriteComponent>

			<touchComponent name="Touch">
            	<size dependentOnElement="element:name()"/>
				<position relativeTo="PARENT"/>
				<orientation priorityOffset="-5" />
				<event name="onTouchDown" params="component, element">
					onTouchDown(component, element)
					element["Arrow"]:setColor(0.5, 0.5, 0.5)
				</event>
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					element["Arrow"]:setColor(1.0, 1.0, 1.0)
					element:parent():parent():nextPage()
				</event>
				<event name="onTouchRelease" params="component, element">
					onTouchRelease(component, element)
					element["Arrow"]:setColor(1.0, 1.0, 1.0)
				</event>
			</touchComponent>

			<event name="hide" params="element">
				element["Arrow"]("visible"):SetInt(0)
				element:DoStoredScript("setInvisible")
			</event>

			<event name="show" params="element">
				element["Arrow"]("visible"):SetInt(1)
				element:DoStoredScript("setVisible")
			</event>
		</template>


		<!-- Filters -->
		<template type="template_overlayedcheckbox" name="ShowMonstersBox">
			<templateVar name="$overlaySprite" equals="'button_yes'" />
			<templateVar name="$bgSprite" equals="'button_base_grey'" />
			<templateVar name="$sheetName" equals="'xml_resources/context_buttons.xml'" />
			<templateVar name="$scale" equals="0.25*game.menuScaleY()" />
			<templateVar name="$layer" equals="'HUD'" />
			<templateVar name="$check" equals="game.showingMonstersTileSpots()" />
			<position relativeTo="ShowDecorationsBox" vAnchor="TOP" hAnchor="LEFT" />
			<orientation vAnchor="BOTTOM" hAnchor="LEFT" xOffset="0" yOffset="8*game.menuScaleY()" priorityOffset="0" />
			<touchComponent name="Touch">
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					if(not game.showingMonstersTileSpots()) then
						game.setShowWorldMonsters(true)
						element:DoStoredScript("check")
					else
						game.setShowWorldMonsters(false)
						element:DoStoredScript("uncheck")
					end
				</event>
			</touchComponent>
			<element name="Label">
