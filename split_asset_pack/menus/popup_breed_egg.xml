			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="-16*game.menuScaleY()" priorityOffset="-2" />
			<event name="onInit" params="component, element">
				<![CDATA[
					component("animationName"):SetString("xml_bin/costume_egg.bin")
