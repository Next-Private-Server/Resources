			</event>
		</textComponent>
	</element>
	
	<element name="OnTheRightTrack">
		<size dependentOnElement="element:name()" dependentOnComponent="Box" />
		<position relativeTo="MonsterName" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="2*game.menuScaleX()" priorityOffset="0" />
		<ninesliceComponent name="Box">
			<size w="260*game.hudScale()" h="48*game.hudScale()"/>
			<position relativeTo="element" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				
				component("topHeight"):SetFloat(4.0)
				component("bottomHeight"):SetFloat(4.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("size"):SetFloat(0.5)
				component("includeBorder"):SetInt(1)
				component("spriteName"):SetString("gfx/menu/shmear")
				component("layer"):SetString("MidFrontPopUps")

			</event>
		</ninesliceComponent>
		<textComponent name="Text">
			<size w="260*game.hudScale()" />
			<position relativeTo="element" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-2*game.hudScale()" priorityOffset="-1" />
			<event name="onInit" params="component, element">
				component("textPadding"):SetInt(30)
				component("autoScale"):SetInt(1)
				component("font"):Set(game.getTextFont())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)				
				--component("text"):SetString("Triple elementals often take a few tries.\nYou're on the right track!")				
				component("text"):SetString("NOTIFICATION_FAILED_TRIPLE_BREEDING")				
				component("size"):SetFloat(0.23*game.hudScale())
				component("layer"):SetString("MidFrontPopUps")
			</event>
		</textComponent>
		<event name="Hide" params="element">
		<![CDATA[
			element.Box("visible"):SetInt(0)
			element.Text("visible"):SetInt(0)
			--also set height to 0
			element.Box:setSize(Vector2(0, 2*game.hudScale()))
		]]>
		</event>

	</element>

