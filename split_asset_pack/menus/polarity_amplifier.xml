<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="menu.xsd">
	<script src="scripts/PolarityAmplifier.lua" />

	<template type="template_fade" name="Fade">
		<templateVar name="$layer" equals="MidPopUps" />
		<templateVar name="$priority" equals="22" />
	</template>
	
	<element name="bg">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="lua_sys.screenHeight() * 2.0" priorityOffset="21" />
		<ninesliceComponent name="Sprite">
			<size w="430*game.menuScaleX()" h="255*game.menuScaleX()" />
			<event name="onInit" params="component, element">
				component("includeBorder"):SetInt(1)
				component("topHeight"):SetFloat(49.0)
				component("bottomHeight"):SetFloat(49.0)
				component("leftWidth"):SetFloat(49.0)
				component("rightWidth"):SetFloat(49.0)
				component("size"):SetFloat(0.5*game.menuScaleX())
				component("spriteName"):SetString("gfx/menu/Black9SFrame50Sm")
				component("layer"):SetString("MidPopUps")
			</event>
		</ninesliceComponent>
	</element>
	
	<element name="TitleFrame">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="bg" vAnchor="TOP" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="-20*game.hudScale()" priorityOffset="-3" />
		<ninesliceComponent name="Sprite">
			<size w="250*game.menuScaleX()" h="35*game.menuScaleX()" />
			<event name="onInit" params="component, element">
				component("topHeight"):SetFloat(44.0)
				component("bottomHeight"):SetFloat(44.0)
				component("leftWidth"):SetFloat(50.0)
				component("rightWidth"):SetFloat(50.0)
				component("size"):SetFloat(0.25*game.menuScaleX())
				component("includeBorder"):SetInt(1)
				component("spriteName"):SetString("gfx/menu/GreyTitleFrame")
				component("layer"):SetString("MidPopUps")
			</event>
		</ninesliceComponent>
	</element>
	
	<element name="Title">
		<size dependentOnElement="element:name()" dependentOnComponent="Text"/>
		<position relativeTo="TitleFrame" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
		<textComponent name="Text">
			<size w="240*game.menuScaleX()" />
			<event name="onInit" params="component, element">
				component("font"):Set(game.getTitleFont())
				component("multiline"):SetInt(0)
				component("size"):SetFloat(0.32*game.menuScaleX())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
				local palette = include("ColourPalette")
				component:setColor(palette:getRGBFloats(palette.TITLE_YELLOW))
				component("text"):SetString("POLARITY_AMPLIFIER_MENU_TITLE")
				component("autoScale"):SetInt(1)
				component("layer"):SetString("MidPopUps")
			</event>
		</textComponent>
	</element>

	<element name="Description">
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="bg" vAnchor="TOP" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="40*game.menuScaleX()" priorityOffset="-1" />
		<textComponent name="Text">
			<size w="325*game.menuScaleX()" h="120*game.menuScaleX()" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(1)
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.2*game.menuScaleX())
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
				component("layer"):SetString("MidPopUps")
				component("text"):SetString("POLARITY_AMPLIFIER_MENU_DESC")
				component("autoScale"):SetInt(1)
			</event>
		</textComponent>
	</element>

	<element name="Vine">
		<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
		<position relativeTo="bg" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="BOTTOM" hAnchor="RIGHT" xOffset="50*game.menuScaleX()" yOffset="10*game.menuScaleX()" priorityOffset="-1" />
		<spriteSheetComponent name="Sprite">
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onInit" params="component, element">		
				component("sheetName"):SetString("xml_resources/polarity_amplifier_HUD_sheet.xml")
				component("spriteName"):SetString("polamp_vine")
				component("size"):SetFloat(0.45*game.menuScaleX())
				component("layer"):SetString("MidPopUps")
			</event>
		</spriteSheetComponent>
	</element>

	<template type="template_polarity_amplifier_meter" name="Meter_1">
		<position relativeTo="Vine" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="-2*game.menuScaleX()" yOffset="10*game.menuScaleX()" priorityOffset="-1" />
	</template>

	<template type="template_polarity_amplifier_meter" name="Meter_2">
		<position relativeTo="Vine" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="-6*game.menuScaleX()" yOffset="41*game.menuScaleX()" priorityOffset="-1" />
	</template>

	<template type="template_polarity_amplifier_meter" name="Meter_3">
		<position relativeTo="Vine" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="-5*game.menuScaleX()" yOffset="72*game.menuScaleX()" priorityOffset="-1" />
	</template>

	<template type="template_polarity_amplifier_meter" name="Meter_4">
		<position relativeTo="Vine" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="0*game.menuScaleX()" yOffset="102.5*game.menuScaleX()" priorityOffset="-1" />
	</template>

	<template type="template_polarity_amplifier_meter" name="Meter_5">
		<position relativeTo="Vine" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="RIGHT" xOffset="5*game.menuScaleX()" yOffset="134*game.menuScaleX()" priorityOffset="-1" />
	</template>

	
	<template type="template_polarity_amplifier_level" name="Level_1">
		<templateVar name="$text" equals="POLARITY_AMPLIFIER_LEVEL_1" />
		<templateVar name="$lockedText" equals="POLARITY_AMPLIFIER_LEVEL_1_LOCKED" />
		<position relativeTo="Vine" vAnchor="TOP" hAnchor="RIGHT" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="18*game.menuScaleX()" priorityOffset="-1" />
	</template>

	<template type="template_polarity_amplifier_level" name="Level_2">
		<templateVar name="$text" equals="POLARITY_AMPLIFIER_LEVEL_2" />
		<templateVar name="$lockedText" equals="POLARITY_AMPLIFIER_LEVEL_2_LOCKED" />
		<position relativeTo="Level_1" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="5*game.menuScaleX()" priorityOffset="-1" />
	</template>

	<template type="template_polarity_amplifier_level" name="Level_3">
		<templateVar name="$text" equals="POLARITY_AMPLIFIER_LEVEL_3" />
		<templateVar name="$lockedText" equals="POLARITY_AMPLIFIER_LEVEL_3_LOCKED" />
		<position relativeTo="Level_2" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="5*game.menuScaleX()" priorityOffset="-1" />
	</template>

	<template type="template_polarity_amplifier_level" name="Level_4">
		<templateVar name="$text" equals="POLARITY_AMPLIFIER_LEVEL_4" />
		<templateVar name="$lockedText" equals="POLARITY_AMPLIFIER_LEVEL_4_LOCKED" />
		<position relativeTo="Level_3" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="5*game.menuScaleX()" priorityOffset="-1" />
	</template>

	<template type="template_polarity_amplifier_level" name="Level_5">
		<templateVar name="$text" equals="POLARITY_AMPLIFIER_LEVEL_5" />
		<templateVar name="$lockedText" equals="POLARITY_AMPLIFIER_LEVEL_5_LOCKED" />
		<position relativeTo="Level_4" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="5*game.menuScaleX()" priorityOffset="-1" />
	</template>

</menu>