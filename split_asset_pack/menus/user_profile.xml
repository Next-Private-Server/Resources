		<element name="FriendCode">
			<size dependentOnElement="element:name()" dependentOnComponent="Text" />
			<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="LEFT" />
			<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="12*game.windowScaleY()" yOffset="-16*game.windowScaleY()" priorityOffset="-4" />
			<textComponent name="Text">
				<size w="160*game.windowScaleY()" />
				<event name="onInit" params="component, element">
					component("multiline"):SetInt(0)
					component("font"):Set(game.getTextFont())
					component("size"):SetFloat(0.2*game.windowScaleY())
					component("text"):SetString(game.getLocalizedText("FRIEND_CODE_USER") .. " AAAA-AAAA-AAAA")
					component("autoScale"):SetInt(1)
					component("layer"):SetString("MidPopUps")
				</event>
			</textComponent>

			<template type="template_spritesheetbutton" name="CopyIdButton">
				<templateVar name="$layer" equals="MidPopUps" />
				<templateVar name="$spriteScale" equals="0.14*game.windowScaleY()" />
				<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="RIGHT" />
				<orientation vAnchor="VCENTER" hAnchor="LEFT" xOffset="2*game.windowScaleY()" yOffset="1*game.windowScaleY()" priorityOffset="0" />
				<spriteSheetComponent name="icon">
					<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
					<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
					<event name="onInit" params="component, element">
						component("sheetName"):SetString("xml_resources/composer_buttons01.xml")
						component("spriteName"):Set("button_copy")
						component("size"):SetFloat(element:C("UpSprite")("size"):GetFloat())
						component("layer"):SetString("MidPopUps")
					</event>
					<event name="onTick" params="component, element, dt">
						if(component("size"):GetFloat() ~= element:C("UpSprite")("size"):GetFloat()) then
							component("size"):SetFloat(element:C("UpSprite")("size"):GetFloat())
						end
					</event>
				</spriteSheetComponent>
				<touchComponent name="Touch">
					<event name="onTouchDown" params="component, element">
						onTouchDown(component, element)
						element:C("icon"):setColor(0.5, 0.5, 0.5)
					</event>
					<event name="onTouchUp" params="component, element">
						onTouchUp(component, element)
						element:C("icon"):setColor(1.0, 1.0, 1.0)
						game.setClipboardText(game.playerFriendCode(), "Friend Code")
						element:parent().Tooltip:Show()
					</event>
					<event name="onTouchRelease" params="component, element">
						onTouchRelease(component, element)
						element:C("icon"):setColor(1.0, 1.0, 1.0)
					</event>
				</touchComponent>
				<event name="hide" params="element">
					element:C("icon")("visible"):SetInt(0)
					element:DoStoredScript("setInvisible")
				</event>
				<event name="show" params="element">
					element:C("icon")("visible"):SetInt(1)
					element:DoStoredScript("setVisible")
				</event>
			</template>

			<template type="template_tooltip" name="Tooltip">
				<position relativeTo="CopyIdButton" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<event name="onPostInit" params="element">
					<![CDATA[
						element.Sprite:setSize(lua_sys.Vector2(220*game.hudScale(), 80*game.hudScale()))
						element.Text:GetVar("text"):SetString("FRIEND_CODE_COPIED_TO_CLIPBOARD")
						element.onDoneShow = function() element:Hide() end
					]]>
				</event>
			</template>

			<event name="setInvisible" params="element">
				element:C("Text")("visible"):SetInt(0)
				element:E("CopyIdButton"):DoStoredScript("hide")
			</event>
			<event name="setVisible" params="element">
				element:C("Text")("visible"):SetInt(1)
				element:E("CopyIdButton"):DoStoredScript("show")
			</event>
		</element>

		<template type="template_spritesheetbutton" name="DeleteButton">
			<templateVar name="$upSpriteName" equals="'button_long_grey@2x'" />
			<templateVar name="$sheetName" equals="'xml_resources/buttons01.xml'" />		
			<templateVar name="$spriteScale" equals="0.35*game.windowScaleY()" />
			<templateVar name="$layer" equals="'MidPopUps'" />

			<position relativeTo="PARENT" vAnchor="BOTTOM" hAnchor="RIGHT" />
			<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="12*game.windowScaleY()" yOffset="-20*game.windowScaleY()" priorityOffset="-1" />

			<textComponent name="Label">
				<size w="50*game.windowScaleY()" h="30*game.windowScaleY()"/>
				<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="-1" />
				<event name="onInit" params="component, element">
					component("multiline"):SetInt(0)
					component("font"):Set(game.getTitleFont())
					component("size"):SetFloat(0.25*game.windowScaleY())
					component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
					component("text"):SetString(game.getLocalizedText("CONTEXTBAR_REMOVE_LABEL"))
					component("textPadding"):SetInt(4*game.windowScaleY())
					component("autoScaleFactor"):SetFloat(0.01)
					component("autoScale"):SetInt(1)
					component("layer"):SetString("MidPopUps")
				</event>
			</textComponent>
			<touchComponent name="Touch">
				<event name="onTouchUp" params="component, element">
					onTouchUp(component, element)
					element:parent():parent():OnDeleteButton()
				</event>
			</touchComponent>
			
			<event name="setInvisible" params="element">
				setInvisible(element)
				element:C("Label")("visible"):SetInt(0)
			</event>
			<event name="setVisible" params="element">
				setVisible(element)
				element:C("Label")("visible"):SetInt(1)
			</event>
		</template>

    </element>

</menu>